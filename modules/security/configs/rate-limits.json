{"version": "1.0.0", "description": "Rate Limiting Configuration for National SOC Platform Algeria", "lastUpdated": "2024-01-15T00:00:00Z", "algorithm": "token-bucket", "globalSettings": {"enabled": true, "defaultWindowMs": 60000, "defaultMaxRequests": 100, "defaultBurstLimit": 20, "refillRatePerSecond": 10, "responseHeaders": {"enabled": true, "remainingHeader": "X-RateLimit-Remaining", "resetHeader": "X-RateLimit-Reset", "totalHeader": "X-RateLimit-Limit", "retryAfterHeader": "Retry-After"}, "errorMessage": {"en": "Rate limit exceeded. Please slow down.", "fr": "Limite de taux dépassée. Veuillez ralentir.", "ar": "تم تجاوز الحد المسموح به. يرجى التباطؤ."}, "statusCode": 429, "ipWhitelist": ["10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12"], "ipBlacklist": []}, "rules": [{"id": "rl_general", "name": "General API Rate Limit", "description": "Default rate limit for all API endpoints", "enabled": true, "priority": 1, "windowMs": 60000, "maxRequests": 100, "burstLimit": 20, "keyGenerator": "{{ip}}", "applyTo": ["/api/*"], "skipSuccessfulRequests": false, "skipFailedRequests": false}, {"id": "rl_auth", "name": "Authentication Rate Limit", "description": "Strict rate limit for authentication endpoints (brute force protection)", "enabled": true, "priority": 2, "windowMs": 900000, "maxRequests": 10, "burstLimit": 3, "keyGenerator": "{{ip}}:{{path}}", "applyTo": ["/api/auth/login", "/api/auth/register", "/api/auth/forgot-password"], "skipSuccessfulRequests": false, "skipFailedRequests": false}, {"id": "rl_password", "name": "Password Change Rate Limit", "description": "Very strict limit for password changes", "enabled": true, "priority": 2, "windowMs": 3600000, "maxRequests": 3, "burstLimit": 1, "keyGenerator": "{{user_id}}", "applyTo": ["/api/auth/password/change", "/api/auth/password/reset"]}, {"id": "rl_search", "name": "Search API Rate Limit", "description": "Rate limit for search endpoints (resource intensive)", "enabled": true, "priority": 5, "windowMs": 60000, "maxRequests": 30, "burstLimit": 10, "keyGenerator": "{{user_id}}:{{path}}", "applyTo": ["/api/search/*", "/api/ioc/search"]}, {"id": "rl_export", "name": "Export Rate Limit", "description": "Strict limit for data export operations", "enabled": true, "priority": 5, "windowMs": 3600000, "maxRequests": 5, "burstLimit": 2, "keyGenerator": "{{user_id}}", "applyTo": ["/api/export/*", "/api/reports/generate"]}, {"id": "rl_webhook", "name": "Webhook Rate Limit", "description": "Rate limit for webhook triggers", "enabled": true, "priority": 10, "windowMs": 60000, "maxRequests": 20, "burstLimit": 5, "keyGenerator": "{{user_id}}:{{webhook_id}}", "applyTo": ["/api/webhooks/*/trigger"]}, {"id": "rl_admin", "name": "Admin Operations Rate Limit", "description": "Rate limit for administrative operations", "enabled": true, "priority": 3, "windowMs": 60000, "maxRequests": 50, "burstLimit": 10, "keyGenerator": "{{user_id}}", "applyTo": ["/api/admin/*", "/api/config/*", "/api/users/*"], "skipSuccessfulRequests": false}, {"id": "rl_public", "name": "Public Endpoint Rate Limit", "description": "Lenient rate limit for public/read-only endpoints", "enabled": true, "priority": 20, "windowMs": 60000, "maxRequests": 200, "burstLimit": 50, "keyGenerator": "{{ip}}", "applyTo": ["/api/public/*", "/api/status", "/api/health"]}], "violationHandling": {"logAllViolations": true, "blockDuration": {"firstViolation": 0, "secondViolation": 60000, "thirdViolation": 300000, "fourthPlusViolation": 900000}, "alertOnThreshold": {"critical": 90, "high": 70, "medium": 50}, "notifyChannels": ["audit-log", "slack-alerts"]}, "bypassConditions": {"apiKeyAuthenticated": {"enabled": true, "multiplier": 2}, "mfaVerified": {"enabled": true, "multiplier": 1.5}, "serviceAccount": {"enabled": true, "multiplier": 3}, "internalNetwork": {"enabled": true, "cidrRanges": ["10.0.0.0/8", "192.168.0.0/16"], "multiplier": 5}}}