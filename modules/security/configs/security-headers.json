{"version": "1.0.0", "description": "Security Headers Configuration for National SOC Platform Algeria", "lastUpdated": "2024-01-15T00:00:00Z", "headers": {"strict-transport-security": {"enabled": true, "value": "max-age=31536000; includeSubDomains; preload", "options": {"maxAge": 31536000, "includeSubDomains": true, "preload": true, "preloadSubmitted": false}, "description": "Forces HTTPS connections and prevents protocol downgrade attacks"}, "x-frame-options": {"enabled": true, "value": "DENY", "options": {"policy": "DENY", "allowFrom": null}, "description": "Prevents clickjacking attacks by controlling frame embedding"}, "x-content-type-options": {"enabled": true, "value": "nosniff", "description": "Prevents MIME type sniffing by browsers"}, "x-xss-protection": {"enabled": true, "value": "0", "description": "Disables legacy XSS filter (replaced by Content-Security-Policy)"}, "referrer-policy": {"enabled": true, "value": "strict-origin-when-cross-origin", "description": "Controls how much referrer information is sent with requests"}, "content-security-policy": {"enabled": true, "reportOnly": false, "directives": {"default-src": "'self'", "script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net", "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net", "img-src": "'self' data: blob: https:", "font-src": "'self' https://fonts.gstatic.com https://cdn.jsdelivr.net", "connect-src": "'self' wss: https:", "media-src": "'self'", "object-src": "'none'", "frame-src": "'self'", "frame-ancestors": "'none'", "base-uri": "'self'", "form-action": "'self'", "upgrade-insecure-requests": true}, "reportUri": "/api/security/csp-report", "description": "Prevents XSS, data injection, and other code injection attacks"}, "permissions-policy": {"enabled": true, "directives": {"accelerometer": ["()"], "ambient-light-sensor": ["()"], "autoplay": ["(self)"], "battery": ["()"], "camera": ["()"], "clipboard-read": ["()"], "clipboard-write": ["(self)"], "displaycapture": ["()"], "document-domain": ["()"], "encrypted-media": ["(self)"], "fullscreen": ["(self)"], "geolocation": ["()"], "gyroscope": ["()"], "hid": ["()"], "magnetometer": ["()"], "microphone": ["()"], "midi": ["()"], "payment": ["()"], "picture-in-picture": ["(self)"], "publickey-credentials-get": ["(self)"], "screen-wake-lock": ["()"], "serial": ["()"], "usb": ["()"], "web-share": ["(self)"], "xr-spatial-tracking": ["()"]}, "description": "Controls which browser features can be used"}, "cross-origin-opener-policy": {"enabled": true, "value": "same-origin", "description": "Isolates browsing context from cross-origin windows"}, "cross-origin-embedder-policy": {"enabled": true, "value": "require-corp", "description": "Prevents loading of cross-origin resources without explicit permission"}, "cross-origin-resource-policy": {"enabled": true, "value": "same-origin", "description": "Restricts cross-origin access to resources"}, "cache-control": {"enabled": true, "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0", "description": "Prevents caching of sensitive pages"}, "pragma": {"enabled": true, "value": "no-cache", "description": "HTTP/1.0 cache control directive"}, "expires": {"enabled": true, "value": "0", "description": "Sets immediate expiration for cache control"}, "expect-ct": {"enabled": true, "value": "max-age=86400, enforce", "description": "Enforces Certificate Transparency requirements"}}, "customHeaders": [{"name": "X-Powered-By", "value": "National-SOC-Algeria/1.0", "always": true, "description": "Server identification header"}, {"name": "X-Permitted-Cross-Domain-Policies", "value": "none", "always": true, "description": "Cross-domain policy control"}, {"name": "X-Content-Type-Options", "value": "nosniff", "always": true, "description": "MIME type sniffing prevention (redundant with main config)"}, {"name": "Content-Security-Policy-Report-Only", "value": null, "always": false, "enabled": false, "description": "CSP report-only mode (for testing)"}], "environmentOverrides": {"development": {"content-security-policy": {"directives": {"script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net webpack://*", "connect-src": "'self' wss: https: http://localhost:* http://localhost:*"}}}, "staging": {"strict-transport-security": {"value": "max-age=86400; includeSubDomains"}}, "production": {"strict-transport-security": {"value": "max-age=31536000; includeSubDomains; preload"}}}, "validation": {"requiredHeaders": ["Strict-Transport-Security", "X-Frame-Options", "X-Content-Type-Options", "Content-Security-Policy", "Referrer-Policy", "Permissions-Policy"], "scoring": {"weights": {"critical": 25, "high": 15, "medium": 5, "low": 2, "info": 0}, "gradeThresholds": {"A+": 95, "A": 90, "B": 80, "C": 70, "D": 60, "F": 0}}}}