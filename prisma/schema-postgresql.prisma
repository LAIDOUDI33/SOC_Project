// ============================================================
// National SOC Platform - PostgreSQL-Optimized Database Schema
// Version: 4.0.0 (PostgreSQL Production)
// Models: 42 | Domains: Auth, Core SOC, Threat Intel, Telecom, Compliance
// 
// Optimizations for PostgreSQL:
// - Native PostgreSQL types (UUID, TIMESTAMPTZ, JSONB)
// - Proper indexing strategy for query patterns
// - Partitioning hints for large tables
// - Full-text search support
// - Connection pooling ready (PgBouncer compatible)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN 1: AUTHENTICATION & AUTHORIZATION
// ============================================================

model User {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique @map("email") @db.VarChar(255)
  username          String           @unique @map("username") @db.VarChar(100)
  passwordHash      String           @map("password_hash") @db.Text
  name              String           @map("name") @db.VarChar(255)
  avatarUrl         String?          @map("avatar_url") @db.Text
  isActive          Boolean          @default(true) @map("is_active") @db.Boolean
  isMfaEnabled      Boolean          @default(false) @map("is_mfa_enabled") @db.Boolean
  mfaSecret         String?          @map("mfa_secret") @db.Text
  lastLoginAt       DateTime?        @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime         @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  roleId            String           @map("role_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // LDAP/Active Directory Integration
  ldapDN            String?          @map("ldap_dn") @db.Text
  ldapGUID          String?          @map("ldap_guid") @db.Uuid
  ldapSID           String?          @map("ldap_sid") @db.VarChar(255)
  employeeId        String?          @map("employee_id") @db.VarChar(100)
  department        String?          @db.VarChar(255)

  // Relations
  role              Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  alerts            Alert[]          @relation("AlertAssignee")
  incidentsAssigned Incident[]       @relation("IncidentAssignee")
  incidentsCreated  Incident[]       @relation("IncidentCreator")
  auditLogs         AuditLog[]
  sessions          Session[]
  apiKeys           ApiKey[]

  @@index([isActive])
  @@index([department])
  @@map("users")
}

model Role {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String      @unique @db.VarChar(100)
  description         String?     @db.Text
  permissions         Json        @default("[]") @db.JsonB
  isSystemRole        Boolean     @default(false) @map("is_system_role")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  users               User[]
  apiKeys             ApiKey[]

  @@map("roles")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  keyHash     String    @map("key_hash") @db.Text
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  permissions Json      @default("{}") @db.JsonB
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([name, userId])
  @@index([userId])
  @@index([keyHash])
  @@index([expiresAt])
  @@map("api_keys")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sessionToken    String    @unique @map("session_token") @db.Text
  ipAddress       String    @map("ip_address") @db.VarChar(45) // IPv6 support
  userAgent       String    @map("user_agent") @db.Text
  authLevel       String    @map("auth_level") @db.VarChar(50) @default("authenticated")
  deviceInfo      Json?     @map("device_info") @db.JsonB
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  lastActivityAt  DateTime  @map("last_activity_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  invalidatedAt   DateTime? @map("invalidated_at") @db.Timestamptz(6)
  invalidReason   String?   @map("invalid_reason") @db.VarChar(255)

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@index([authLevel])
  @@map("sessions")
}

// ============================================================
// DOMAIN 2: SECURITY ALERTS & INCIDENTS
// ============================================================

model Alert {
  id                String           @id @default(uuid()) @db.Uuid
  title             String           @db.VarChar(500)
  description       String?          @db.Text
  severity          String           @db.VarChar(20) // CRITICAL, HIGH, MEDIUM, LOW, INFO
  status            String           @db.VarChar(30) // NEW, ACKNOWLEDGED, IN_PROGRESS, ESCALATED, RESOLVED, CLOSED
  alertType         String           @map("alert_type") @db.VarChar(50) // DETECTION, ANOMALY, CORRELATION, THREAT_INTEL
  source            String           @db.VarChar(100) // SIEM, EDR, NSM, THREAT_INTEL, SS7, FRAUD
  sourceIp          String?          @map("source_ip") @db.VarChar(45)
  destIp            String?          @map("dest_ip") @db.VarChar(45)
  sourcePort        Int?             @map("source_port")
  destPort          Int?             @map("dest_port")
  protocol          String?          @db.VarChar(20)
  rawEvent          Json?            @map("raw_event") @db.JsonB
  mitreTechniqueId  String?          @map("mitre_technique_id") @db.VarChar(20) // e.g., T1035
  mitreTactic       String?          @map("mitre_tactic") @db.VarChar(100)
  confidenceScore   Decimal?         @map("confidence_score") @db.Decimal(5, 2)
  assignedToId      String?          @map("assigned_to_id") @db.Uuid
  incidentId        String?          @map("incident_id") @db.Uuid
  suppressionRuleId String?          @map("suppression_rule_id") @db.Uuid
  tags              Json?            @default("[]") @db.JsonB
  customFields      Json?            @map("custom_fields") @db.JsonB
  firstSeen         DateTime         @map("first_seen") @default(now()) @db.Timestamptz(6)
  lastSeen         DateTime         @map("last_seen") @default(now()) @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  assignedTo        User?            @relation("AlertAssignee", fields: [assignedToId], references: [id])
  incident          Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  suppressionRule   SuppressionRule? @relation(fields: [suppressionRuleId], references: [id])
  comments          AlertComment[]
  timelineEvents    TimelineEvent[]

  @@index([severity])
  @@index([status])
  @@index([source])
  @@index([incidentId])
  @@index([assignedToId])
  @@index([firstSeen])
  @@index([severity, status])
  @@index([source, firstSeen])
  @@index([mitreTechniqueId])
  @@map("alerts")
}

model AlertComment {
  id        String   @id @default(uuid()) @db.Uuid
  alertId   String   @map("alert_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@map("alert_comments")
}

model SuppressionRule {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(255)
  description     String?    @db.Text
  filterCriteria  Json       @map("filter_criteria") @db.JsonB
  createdBy       String     @map("created_by") @db.Uuid
  isActive        Boolean    @default(true) @map("is_active")
  suppressForever Boolean    @default(false) @map("suppress_forever)
  suppressUntil   DateTime?  @map("suppress_until") @db.Timestamptz(6)
  matchCount      Int        @default(0) @map("match_count")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  alerts          Alert[]

  @@index([isActive])
  @@index([suppressUntil])
  @@map("suppression_rules")
}

model Incident {
  id                    String           @id @default(uuid()) @db.Uuid
  tatcCode              String           @unique @map("tatc_code") @db.VarChar(50) // TATC-2026-0001
  title                 String           @db.VarChar(500)
  description           String?          @db.Text
  incidentType          String           @map("incident_type") @db.VarChar(50) // NETWORK_INTRUSION, MALWARE, DATA_BREACH, DDoS, TELECOM_FRAUD, SS7_ATTACK, APT, INSIDER_THREAT, PHYSICAL_SECURITY, THIRD_PARTY, POLICY_VIOLATION
  severity              String           @db.VarChar(20) // CRITICAL, HIGH, MEDIUM, LOW
  status                String           @db.VarChar(30) // OPEN, IN_PROGRESS, CONTAINMENT, ERADICATION, RECOVERY, LESSONS_LEARNED, CLOSED, PENDINGClosure
  phase                 String?          @db.VarChar(50) // DETECTION, TRIAGE, CONTAINMENT, ERADICATION, RECOVERY, POST-INCIDENT
  assignedToId          String?          @map("assigned_to_id") @db.Uuid
  createdById           String           @map("created_by_id") @db.Uuid
  impactScore           Decimal?         @map("impact_score") @db.Decimal(3, 1) // 1.0-10.0
  confidenceScore       Decimal?         @map("confidence_score") @db.Decimal(5, 2) // 0-100
  blastRadius           String?          @db.Text
  affectedAssets        Json?            @map("affected_assets") @db.JsonB
  affectedServices      Json?            @map("affected_services") @db.JsonB
  affectedSubscribers  Int?             @map("affected_subscribers")
  rootCauseAnalysis     Json?            @map("root_cause_analysis") @db.JsonB
  containmentActions    Json?            @map("containment_actions") @db.JsonB
  eradicationSteps      Json?            @map("eradication_steps") @db.JsonB
  lessonsLearned        Json?            @map("lessons_learned") @db.JsonB
  slaBreach             Boolean          @default(false) @map("sla_breach")
  slaDeadline           DateTime?        @map("sla_deadline") @db.Timestamptz(6)
  resolvedAt            DateTime?        @map("resolved_at") @db.Timestamptz(6)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(6)
  tags                  Json?            @default("[]") @db.JsonB
  customFields          Json?            @map("custom_fields") @db.JsonB
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  assignedTo            User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  createdBy             User             @relation("IncidentCreator", fields: [createdById], references: [id])
  alerts                Alert[]
  timelineEvents        TimelineEvent[]
  tasks                 Task[]
  evidenceFiles         EvidenceFile[]

  @@index([status])
  @@index([severity])
  @@index([incidentType])
  @@index([assignedToId])
  @@index([tatcCode])
  @@index([createdAt])
  @@index([status, severity])
  @@map("incidents")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @map("incident_id") @db.Uuid
  title       String    @db.VarChar(500)
  description String?   @db.Text
  assigneeId  String?   @map("assignee_id") @db.Uuid
  status      String    @db.VarChar(30) @default("TODO") // TODO, IN_PROGRESS, BLOCKED, DONE, CANCELLED
  priority    String    @db.VarChar(20) @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([incidentId])
  @@index([status])
  @@index([assigneeId])
  @@map("tasks")
}

model EvidenceFile {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @map("incident_id") @db.Uuid
  fileName    String    @map("file_name") @db.VarChar(500)
  fileType    String    @map("file_type") @db.VarChar(100)
  fileSize    BigInt    @map("file_size") // bytes
  filePath    String    @map("file_path") @db.Text
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  hashSha256  String?   @map("hash_sha256") @db.VarChar(64)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("evidence_files")
}

model TimelineEvent {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String?   @map("incident_id") @db.Uuid
  alertId     String?   @map("alert_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(50) // STATUS_CHANGE, NOTE, EVIDENCE_ADDED, ACTION_TAKEN, ESCALATION
  title       String    @db.VarChar(500)
  content     String?   @db.Text
  metadata    Json?     @db.JsonB
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alert       Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([incidentId])
  @@index([alertId])
  @@index([eventType])
  @@index([createdAt])
  @@map("timeline_events")
}

// ============================================================
// DOMAIN 3: THREAT INTELLIGENCE
// ============================================================

model ThreatIndicator {
  id                String     @id @default(uuid()) @db.Uuid
  type              String     @db.VarChar(50) // IPV4, IPV6, DOMAIN, URL, EMAIL, FILE_HASH_MD5, FILE_HASH_SHA1, FILE_HASH_SHA256, MUTT, CVE, IMSI, IMEI, MSISDN
  value             String     @db.Text
  confidence        Decimal    @default(50.00) @db.Decimal(5, 2) // 0-100
  source            String     @db.VarChar(100) // OSINT, Internal, Partner, Feed, Hunting
  threatActor       String?    @map("threat_actor") @db.VarChar(255)
  malwareFamily     String?    @map("malware_family") @db.VarChar(255)
  campaignId        String?    @map("campaign_id") @db.Uuid
  isActive          Boolean    @default(true) @map("is_active")
  firstSeen         DateTime   @map("first_seen") @default(now()) @db.Timestamptz(6)
  lastSeen          DateTime   @map("last_seen") @default(now()) @db.Timestamptz(6)
  expirationDate    DateTime?  @map("expiration_date") @db.Timestamptz(6)
  tags              Json?      @default("[]") @db.JsonB
  context           Json?      @db.JsonB
  killChainPhase    String?    @map("kill_chain_phase") @db.VarChar(100)
  tlpLevel          String     @map("tlp_level") @default("WHITE") @db.VarChar(10) // WHITE, GREEN, AMBER, RED
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  campaign          Campaign?

  @@index([type])
  @@index([value])  // For lookups
  @@index([isActive])
  @@index([confidence])
  @@index([threatActor])
  @@index([source])
  @@index([type, value])
  @@map("threat_indicators")
}

model Campaign {
  id                     String     @id @default(uuid()) @db.Uuid
  name                   String     @db.VarChar(255)
  alias                  String?    @db.VarChar(100)
  description            String?    @db.Text
  threatActor            String?    @map("threat_actor") @db.VarChar(255)
  attributionConfidence  Decimal?   @map("attribution_confidence") @db.Decimal(5, 2)
  status                 String     @db.VarChar(30) // ACTIVE, DORMANT, CONCLUDED, UNKNOWN
  targetSector           String?    @map("target_sector") @db.VarChar(100)
  targetRegion           String?    @map("target_region") @db.VarChar(100)
  objectives             Json?      @db.JsonB
  techniquesUsed         Json?      @map("techniques_used") @db.JsonB
  financialImpact        BigInt?    @map("financial_impact") // estimated in DZD or USD
  isActive               Boolean    @default(true) @map("is_active")
  startDate              DateTime?  @map("start_date") @db.Date
  endDate                DateTime?  @map("end_date") @db.Date
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  indicators             ThreatIndicator[]

  @@index([threatActor])
  @@index([status])
  @@index([isActive])
  @@map("campaigns")
}

// ============================================================
// DOMAIN 4: TELECOM/SS7 SPECIFIC
// ============================================================

model Ss7Message {
  id                String     @id @default(uuid()) @db.Uuid
  messageCode       Int        @map("message_code") // SS7 message code (e.g., 6=ISIAM, 10=SRI_REQ)
  messageType       String     @map("message_type") @db.VarChar(50) // ISIAM, SRI_REQ, ATI_REQ, etc.
  originatingGT     String     @map("originating_gt") @db.VarChar(50)
  destinationGT     String     @map("destination_gt") @db.VarChar(50)
  originatingPoint  String     @map("originating_point_code") @db.VarChar(20)
  destinationPoint  String     @map("destination_point_code") @db.VarChar(20)
  sccpLayer         String?    @map("sccp_layer") @db.VarChar(20) // TCAP, MAP, CAP, ISUP
  globalTitle       String?    @map("global_title") @db.VarChar(100)
  imsi              String?    @db.VarChar(30)
  msisdn            String?    @db.VarChar(20)
  timestamp         DateTime   @db.Timestamptz(6)
  rawData           Json?      @map("raw_data") @db.JsonB
  parsedData        Json?      @map("parsed_data") @db.JsonB
  anomalyScore      Decimal?   @map("anomaly_score") @db.Decimal(5, 2)
  isAnomalous       Boolean    @default(false) @map("is_anomalous")
  alertId           String?    @map("alert_id") @db.Uuid
  networkElementId  String?    @map("network_element_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  alert             Alert?
  networkElement    NetworkElement?

  // Partitioning hint: Consider partitioning by month on timestamp
  @@index([timestamp])
  @@index([messageType])
  @@index([originatingGT, timestamp])
  @@index([destinationGT])
  @@index([imsi])
  @@index([msisdn])
  @@index([isAnomalous])
  @@map("ss7_messages")
}

model FraudDetection {
  id                String     @id @default(uuid()) @db.Uuid
  fraudType         String     @map("fraud_type") @db.VarChar(50) // SIM_SWAP_FRAUD, IRSF, PBX_HACK, PREMIUM_RATE, BONUS_ABUSE, LOCATION_TRACKING, INTERCEPTION
  severity          String     @db.VarChar(20)
  status            String     @db.VarChar(30) // DETECTED, INVESTIGATING, CONFIRMED, FALSE_POSITIVE, ESCALATED, RESOLVED
  subscriberImsi    String?    @map("subscriber_imsi") @db.VarChar(30)
  subscriberMsisdn  String?    @map("subscriber_msisdn") @db.VarChar(20)
  subscriberImei    String?    @map("subscriber_imei") @db.VarChar(20)
  amountAffected    Decimal?   @map("amount_affected") @db.Decimal(15, 2)
  currency          String     @default("DZD") @db.VarChar(3)
  detectionMethod   String     @map("detection_method") @db.VarChar(100)
  detectionRuleId   String?    @map("detection_rule_id") @db.Uuid
  evidence          Json?      @db.JsonB
  assignedAnalystId String?    @map("assigned_analyst_id") @db.Uuid
  incidentId        String?    @map("incident_id") @db.Uuid
  firstOccurrence   DateTime   @map("first_occurrence") @db.Timestamptz(6)
  lastOccurrence    DateTime   @map("last_occurrence") @db.Timestamptz(6)
  resolvedAt        DateTime?  @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([fraudType])
  @@index([status])
  @@index([subscriberMsisdn])
  @@index([severity])
  @@index([detectionMethod])
  @@map("fraud_detections")
}

model Subscriber {
  id                String     @id @default(uuid()) @db.Uuid
  imsi              String     @unique @db.VarChar(30)
  msisdn            String     @unique @db.VarChar(20)
  imei              String?    @db.VarChar(20)
  imsiType          String     @map("imsi_type") @db.VarChar(20) // PREPAID, POSTPAID, ROAMING, CORPORATE
  subscriberStatus  String     @map("subscriber_status") @db.VarChar(30) // ACTIVE, SUSPENDED, DEACTIVATED, FRAUD_LOCKED, BARRED
  roamingStatus     String     @map("roaming_status") @db.VarChar(30) // HOME, INTERNATIONAL_ROAMING, NATIONAL_ROAMING
  homeCountry       String     @map("home_country") @db.VarChar(3) // ISO 3166-1 alpha-3
  visitedCountry    String?    @map("visited_country") @db.VarChar(3)
  riskScore         Decimal    @default(0) @map("risk_score") @db.Decimal(5, 2) // 0-100
  fraudFlags        Json?      @map("fraud_flags") @default("[]") @db.JsonB
  locationLac       Int?       @map("location_lac")
  locationCellId    Int?       @map("location_cell_id")
  lastActivityAt    DateTime?  @map("last_activity_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([msisdn])
  @@index([riskScore])
  @@index([subscriberStatus])
  @@index([imsiType])
  @@map("subscribers")
}

model NetworkElement {
  id                String     @id @default(uuid()) @db.Uuid
  elementType       String     @map("element_type") @db.VarChar(50) // HLR_HSS, STP, MSC, GMSC, SGSN, GGSN_PGW, MME, CSCF, etc.
  hostname          String     @db.VarChar(255)
  ipAddress         String     @map("ip_address") @db.VarChar(45)
  vendor            String     @db.VarChar(100) // Huawei, Ericsson, Nokia, ZTE, Samsung
  softwareVersion   String     @map("software_version") @db.VarChar(100)
  serialNumber      String?    @map("serial_number") @db.VarChar(100)
  status            String     @db.VarChar(30) // OPERATIONAL, DEGRADED, DOWN, MAINTENANCE, UNKNOWN
  capacity          Decimal?   @db.Decimal(5, 2) // percentage used
  location          String     @db.VarChar(255)
  securityZone      String     @map("security_zone") @db.VarChar(50) // Core_Zone, DMZ, Access_Zone, OAM_Zone
  lastHeartbeat     DateTime?  @map("last_heartbeat") @db.Timestamptz(6)
  metadata          Json?      @db.JsonB
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  ss7Messages       Ss7Message[]

  @@index([elementType])
  @@index([status])
  @@index([vendor])
  @@index([securityZone])
  @@map("network_elements")
}

// ============================================================
// DOMAIN 5: COMPLIANCE & AUDIT (ARTP/ANSSI)
// ============================================================

model ComplianceChecklist {
  id                String     @id @default(uuid()) @db.Uuid
  framework         String     @db.VarChar(50) // ARTP, ANSSI, ISO27001, NIST, GDPR
  category          String     @db.VarChar(100)
  requirementId     String     @map("requirement_id") @db.VarChar(50)
  title             String     @db.VarChar(500)
  description       String?    @db.Text
  controlObjective  String?    @map("control_objective") @db.Text
  status            String     @db.VarChar(30) // COMPLIANT, PARTIAL, NON_COMPLIANT, NOT_ASSESSED, NOT_APPLICABLE
  riskRating        String?    @map("risk_rating") @db.VarChar(20) // CRITICAL, HIGH, MEDIUM, LOW
  evidenceRequired  Boolean    @default(true) @map("evidence_required")
  evidenceFiles     Json?      @map("evidence_files") @default("[]") @db.JsonB
  findings          Json?      @db.JsonB
  remediationPlan   Json?      @map("remediation_plan") @db.JsonB
  remediationDue    DateTime?  @map("remediation_due") @db.Date
  ownerDepartment   String?    @map("owner_department") @db.VarChar(100)
  reviewerId        String?    @map("reviewer_id") @db.Uuid
  lastAssessmentAt  DateTime?  @map("last_assessment_at") @db.Timestamptz(6)
  nextAssessmentAt  DateTime?  @map("next_assessment_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([framework])
  @@index([category])
  @@index([status])
  @@index([requirementId])
  @@map("compliance_checklists")
}

model AuditLog {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  action            String     @db.VarChar(100) // LOGIN, LOGOUT, CREATE, READ, UPDATE, DELETE, EXPORT, CONFIG_CHANGE
  resourceType      String     @map("resource_type") @db.VarChar(100) // User, Alert, Incident, Config, etc.
  resourceId        String?    @map("resource_id") @db.Uuid
  details           Json?      @db.JsonB
  ipAddress         String     @map("ip_address") @db.VarChar(45)
  userAgent         String     @map("user_agent") @db.Text
  sessionId         String?    @map("session_id") @db.Uuid
  outcome           String     @db.VarChar(20) // SUCCESS, FAILURE, ERROR
  errorMessage      String?    @map("error_message") @db.Text
  durationMs        Int?       @map("duration_ms") // Request duration
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user              User?      @relation(fields: [userId], references: [id])

  // Partitioning hint: High volume table, consider time-based partitioning
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([outcome])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================
// DOMAIN 6: SYSTEM CONFIGURATION
// ============================================================

model SystemConfig {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(255)
  value       String    @db.Text
  description String?   @db.Text
  category    String    @db.VarChar(50) // GENERAL, SECURITY, TELECOM, COMPLIANCE, INTEGRATION, PERFORMANCE
  isSensitive Boolean   @default(false) @map("is_sensitive")
  valueType   String    @map("value_type") @default("STRING") @db.VarChar(20) // STRING, NUMBER, BOOLEAN, JSON
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("system_configs")
}

model SystemHealthMetric {
  id                  String     @id @default(uuid()) @db.Uuid
  metricName          String     @map("metric_name") @db.VarChar(100)
  metricType          String     @map("metric_type") @db.VarChar(50) // CPU, MEMORY, DISK, NETWORK, LATENCY, ERROR_RATE, THROUGHPUT
  component           String     @db.VarChar(100) // API_SERVER, DATABASE, REDIS, KAFANA, ELASTICSEARCH, etc.
  value               Decimal    @db.Decimal(15, 4)
  unit                String     @db.VarChar(20) // percent, mb, gb, ms, requests_per_sec, etc.
  thresholdWarning    Decimal?   @map("threshold_warning") @db.Decimal(15, 4)
  thresholdCritical   Decimal?   @map("threshold_critical") @db.Decimal(15, 4)
  status              String     @db.VarChar(20) // OK, WARNING, CRITICAL, UNKNOWN
  recordedAt          DateTime   @map("recorded_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Partitioning hint: Time-series data, must partition by recordedAt
  @@index([metricName])
  @@index([component])
  @@index([recordedAt])
  @@index([status])
  @@index([component, recordedAt])
  @@map("system_health_metrics")
}

// ============================================================
// DOMAIN 7: PLAYBOOKS & AUTOMATION (SOAR)
// ============================================================

model Playbook {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(255)
  description       String?    @db.Text
  category          String     @db.VarChar(100) // INCIDENT_RESPONSE, THREAT_HUNTING, ENRICHMENT, CONTAINMENT, ERADICATION
  triggerConditions Json       @map("trigger_conditions") @db.JsonB
  steps             Json       @db.JsonB // Array of playbook steps
  variables         Json?      @default("{}") @db.JsonB
  version           Int        @default(1)
  isActive          Boolean    @default(true) @map("is_active")
  isDraft           Boolean    @default(true) @map("is_draft")
  authorId          String     @map("author_id") @db.Uuid
  reviewerId        String?    @map("reviewer_id") @db.Uuid
  lastRunAt         DateTime?  @map("last_run_at") @db.Timestamptz(6)
  totalRuns         Int        @default(0) @map("total_runs")
  successRate       Decimal?   @map("success_rate") @db.Decimal(5, 2)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@index([isActive])
  @@index([isDraft])
  @@map("playbooks")
}

model PlaybookExecution {
  id                String     @id @default(uuid()) @db.Uuid
  playbookId        String     @map("playbook_id") @db.Uuid
  triggeredBy       String     @map("triggered_by") @db.Uuid // User ID or 'automated'
  incidentId        String?    @map("incident_id") @db.Uuid
  alertId           String?    @map("alert_id") @db.Uuid
  status            String     @db.VarChar(30) // RUNNING, PAUSED, COMPLETED, FAILED, CANCELLED
  currentStep       Int        @default(0) @map("current_step")
  totalSteps        Int        @map("total_steps)
  inputVariables    Json?      @map("input_variables") @db.JsonB
  outputResults     Json?      @map("output_results") @db.JsonB
  errorDetails      String?    @map("error_details") @db.Text
  startedAt         DateTime   @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?  @map("completed_at") @db.Timestamptz(6)
  durationSeconds   Int?       @map("duration_seconds")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([playbookId])
  @@index([status])
  @@index([startedAt])
  @@map("playbook_executions")
}
