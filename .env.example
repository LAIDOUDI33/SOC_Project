# National SOC Platform - Environment Configuration
# Copy this file to .env.local and fill in the values
# NEVER commit your actual .env file to version control!

# ============================================================
# SECURITY CRITICAL - Authentication Secrets
# ============================================================

# JWT Secret (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here-minimum-32-characters-long

# Refresh Token Secret (different from JWT_SECRET, minimum 32 characters)
# Generate with: openssl rand -base64 48
REFRESH_SECRET=your-refresh-token-secret-here-different-from-jwt

# Encryption Key for sensitive data (MFA secrets, etc.)
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-storage

# ============================================================
# Database Configuration
# ============================================================

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=file:./db/custom.db

# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/soc_platform?schema=public"

# ============================================================
# Application Settings
# ============================================================

# Environment (development, staging, production)
NODE_ENV=development

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# LDAP Configuration (Optional - for SSO integration)
# ============================================================

# LDAP_URL=ldap://your-ldap-server:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=your-ldap-bind-password
# LDAP_BASE_DN=ou=users,dc=example,dc=com

# ============================================================
# SAML Configuration (Optional - for SSO integration)
# ============================================================

# SAML_ENTRY_POINT=https://your-idp-entry-point/sso
# SAML_ISSUER=national-soc-platform
# SAML_CERT=path/to/idp-certificate.pem

# ============================================================
# Integration API Keys (Optional)
# ============================================================

# ANRT_API_KEY=your-anrt-api-key-here
# BILLING_API_KEY=your-billing-api-key-here

# ============================================================
# Feature Flags (DO NOT ENABLE IN PRODUCTION)
# ============================================================

# SECURITY WARNING: Never enable this in production!
# ALLOW_MFA_BYPASS=false
