# ============================================================
# National SOC Platform - Environment Configuration
# Djezzy Algeria - Production Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ----------------------------------------------------------
# NODE ENVIRONMENT
# ----------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# ----------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------
# For development (SQLite):
DATABASE_URL="file:./db/custom.db"

# For production (PostgreSQL):
# DATABASE_URL="postgresql://soc_admin:YOUR_PASSWORD@localhost:5432/soc_platform"

# ----------------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------------

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-different-from-jwt-secret

# Encryption key for sensitive data (32+ characters)
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-32-chars!

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------
# LDAP / ACTIVE DIRECTORY INTEGRATION
# ----------------------------------------------------------
LDAP_URL=ldap://ad.djezzy.dz:389
LDAP_BASE_DN=DC=djezzy,DC=dz
LDAP_USER_SEARCH_BASE=OU=Users,DC=djezzy,DC=dz
LDAP_BIND_DN=CN=soc-service,OU=Service Accounts,DC=djezzy,DC=dz
LDAP_BIND_PASSWORD=ldap-bind-password-here
LDAP_SYNC_ENABLED=true
LDAP_SYNC_INTERVAL=3600000

# ----------------------------------------------------------
# SAML SSO CONFIGURATION
# ----------------------------------------------------------
SAML_ISSUER=https://soc.djezzy.dz
SAML_CALLBACK_URL=https://soc.djezzy.dz/api/auth/saml/callback
SAML_IDP_METADATA_URL=https://sso.djezzy.dz/metadata
SAML_CERT_PATH=./certs/saml-cert.pem
SAML_KEY_PATH=./certs/saml-key.pem

# ----------------------------------------------------------
# REDIS CONFIGURATION (Session Cache & Rate Limiting)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password-here

# ----------------------------------------------------------
# DJEZZY-SPECIFIC CONFIGURATION
# ----------------------------------------------------------
DJEZZY_ENVIRONMENT=production
TZ=Africa/Algiers
DOMAIN=soc.djezzy.dz

# ----------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ----------------------------------------------------------
# EXTERNAL SERVICES (Optional)
# ----------------------------------------------------------
# Elasticsearch for log aggregation
ELASTICSEARCH_URL=http://localhost:9200

# Email service for alerts
SMTP_HOST=smtp.djezzy.dz
SMTP_PORT=587
SMTP_USER=noreply@djezzy.dz
SMTP_PASSWORD=smtp-password-here
SMTP_FROM_EMAIL="SOC Platform <noreply@djezzy.dz>"

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXX/BXX/XXX

# PagerDuty integration (optional)
PAGERDUTY_INTEGRATION_KEY=pagerduty-api-key-here

# ----------------------------------------------------------
# MONITORING CONFIGURATION
# ----------------------------------------------------------
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=grafana-admin-password-here

# Prometheus configuration
PROMETHEUS_RETENTION_DAYS=30

# ----------------------------------------------------------
# COMPLIANCE REPORTING (ARTP/ANSSI)
# ----------------------------------------------------------
ARTP_SUBMISSION_API=https://artp.gov.dz/api/v1
ARTP_ORGANIZATION_ID=djezzy-org-id
ARTP_API_KEY=artp-submission-api-key

# ----------------------------------------------------------
# DEVELOPMENT SETTINGS (Remove in production!)
# ----------------------------------------------------------
# Enable debug mode (shows detailed error messages)
DEBUG=false

# Allow CORS from these origins (development only)
ALLOWED_ORIGINS=http://localhost:3000,http://10.15.1.38:3000

# Skip authentication checks (NEVER set to true in production!)
SKIP_AUTH=false

# Enable demo data seeding
ENABLE_DEMO_DATA=true

# ============================================================
# END OF ENVIRONMENT CONFIGURATION
# ============================================================
# 
# IMPORTANT SECURITY NOTES:
# 1. Never share this file or commit it to Git
# 2. Use strong, unique passwords (minimum 32 characters)
# 3. Rotate secrets regularly (every 90 days)
# 4. Use different secrets for each environment
# 5. Store production secrets in a vault (HashiCorp Vault, AWS Secrets Manager, etc.)
#
# For more information, see:
# - docs/SECURITY.md
# - docs/PRODUCTION_READINESS_ASSESSMENT.md
# ============================================================
