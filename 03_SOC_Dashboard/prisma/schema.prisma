// ============================================================
// Djezzy National SOC Platform - PRODUCTION DATABASE SCHEMA
// Version: 4.0.0 (Production-Ready for Heavy Load)
// Database: PostgreSQL 16+ with partitioning
// Target: 50K+ events/second, 500+ concurrent users
// Features: Time-series partitioning, JSONB, GIN indexes, materialized views
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// EXTENSIONS FOR PRODUCTION FEATURES
// ============================================================
// These extensions must be enabled in PostgreSQL:
// CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
// CREATE EXTENSION IF NOT EXISTS pg_trgm;   -- Trigram matching for fuzzy search
// CREATE EXTENSION IF NOT EXISTS btree_gist; -- For exclusion constraints
// CREATE EXTENSION IF NOT EXISTS pgcrypto;  -- Encryption functions

// ============================================================
// DOMAIN 1: AUTHENTICATION & AUTHORIZATION (Optimized for LDAP/SSO)
// ============================================================

model User {
  id                  UUID       @id @default(uuid())
  email               String     @unique @db.VarChar(255)
  username            String     @unique @db.VarChar(100)
  passwordHash        String     @db.VarChar(255)
  name                String     @db.VarChar(200)
  avatarUrl           String?    @db.Text
  isActive            Boolean    @default(true)
  isMfaEnabled        Boolean    @default(false)
  mfaSecret           String?    @db.VarChar(64)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())
  
  // Role-based access
  roleId              UUID
  
  // LDAP/AD Integration fields
  ldapDN              String?    @map("ldap_dn") @db.Text
  ldapGUID            String?    @map("ldap_guid") @db.VarChar(50)
  employeeId          String?    @map("employee_id") @db.VarChar(50)
  department          String?    @db.VarChar(100)
  title               String?    @db.VarChar(100)
  
  // SSO Integration
  samlNameID          String?    @map("saml_name_id") @db.VarChar(256)
  preferredIdP        String?    @map("preferred_idp") @db.VarChar(100)
  authMethod          String     @default("local") @db.VarChar(20) // local | ldap | saml | oidc
  
  // Security tracking
  loginCount          Int        @default(0)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lastFailedLoginAt   DateTime?  @map("last_failed_login_at")
  isAccountLocked     Boolean    @default(false) @map("is_account_locked")
  isPasswordExpired   Boolean    @default(false) @map("is_password_expired")
  
  // Djezzy-specific
  djezzyCostCenter    String?    @map("djezzy_cost_center") @db.VarChar(20)
  djezzyLocation     String?    @map("djezzy_location") @db.VarChar(100)
  djezzyBadgeNumber  String?    @map("djezzy_badge_number") @db.VarChar(20)
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  role                Role        @relation(fields: [roleId], references: [id])
  sessions            Session[]
  auditLogs           AuditLog[]
  tasks               Task[]
  incidentUpdates     IncidentUpdate[]
  apiKeys             ApiKey[]

  @@index([email])                        // Fast login by email
  @@index([username])                     // Fast login by username
  @@index([authMethod])                   // Filter by auth source
  @@index([isActive, isAccountLocked])    // Security queries
  @@map("users")
}

model Role {
  id          UUID    @id @default(uuid())
  name        String  @unique @db.VarChar(50)
  description String  @db.Text
  permissions Json?   // RBAC permissions as JSON blob
  
  users User[]

  @@map("roles")
}

model Session {
  id            UUID      @id @default(uuid())
  userId        UUID
  token         String    @unique @db.VarChar(512)
  refreshToken  String?   @unique @db.VarChar(512)
  ipAddress     String?   @db.VarChar(45)  // IPv6 support
  userAgent     String?   @db.Text
  deviceFingerprint? String? @db.VarChar(64)
  expiresAt     DateTime
  lastActivity  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])                       // User's active sessions
  @@index([token])                        // Session lookup
  @@index([expiresAt])                    // Cleanup expired sessions
  @@index([ipAddress])                    // Security: sessions from IP
  @@map("sessions")
}

model ApiKey {
  id          UUID      @id @default(uuid())
  userId      UUID
  name        String    @db.VarChar(100)
  keyHash     String    @db.VarChar(255)  // Hashed API key
  scopes      String[]  // ['alerts:read', 'incidents:write', ...]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])                       // API key validation
  @@map("api_keys")
}

// ============================================================
// DOMAIN 2: CORE SOC - ALERTS & INCIDENTS (PARTITIONED BY TIME)
// ============================================================

model Alert {
  id                  UUID              @id @default(uuid())
  externalId          String?           @map("external_id") @db.VarChar(200)  // SIEM event ID
  title               String            @db.VarChar(500) NOT NULL
  description         String?           @db.Text
  severity            AlertSeverity     @default(MEDIUM)
  status              AlertStatus       @default(NEW)
  alertType           AlertType         @default(DETECTION)
  category            String?           @db.VarChar(100)           // Malware, Phishing, DDoS, etc.
  source              String            @db.VarChar(100) NOT NULL  // siem, edr, ti, manual, telecom
  
  // Network context
  sourceIp            InetAddress?      @map("source_ip")
  destIp              InetAddress?      @map("dest_ip")
  sourcePort          Int?              @map("source_port")
  destPort            Int?              @map("dest_port")
  protocol            String?           @db.VarChar(20)
  
  // MITRE ATT&CK mapping
  mitreTactics        String?           @map("mitre_tactics") @db.Text
  mitreTechniques     String?           @map("mitre_techniques") @db.Text
  mitreSubtechniques  String?           @map("mitre_subtechniques") @db.Text
  
  // Raw event data (flexible schema for different sources)
  rawEvent            Json?
  
  // Enrichment data
  enrichedData        Json?             @map("enriched_data")  // GeoIP, WHOIS, threat intel lookup results
  
  // Relations
  incidentId          UUID?             @map("incident_id")
  assignedToId        UUID?             @map("assigned_to_id")
  suppressionRuleId   UUID?             @map("suppression_rule_id")
  
  // Tracking
  escalationCount     Int               @default(0) @map("escalation_count")
  isSuppressed        Boolean           @default(false) @map("is_suppressed")
  suppressionReason   String?           @map("suppression_reason") @db.Text
  
  // Timestamps (critical for time-series queries)
  firstSeen           DateTime          @default(now()) NOT NULL
  lastSeen            DateTime          @default(now()) NOT NULL
  acknowledgedAt      DateTime?         @map("acknowledged_at")
  resolvedAt          DateTime?         @map("resolved_at")
  createdAt           DateTime          @default(now()) NOT NULL
  updatedAt           DateTime          @updatedAt

  incident            Incident?        @relation(fields: [incidentId], references: [id])
  assignedTo          User?            @relation("AlertAssignee", fields: [assignedToId], references: [id])

  // Optimized indexes for production workloads
  @@index([status, severity])                          // Dashboard: alerts by status/severity
  @@index([firstSeen])                                 // Time-range queries
  @@index([source, firstSeen])                         // Source-specific queries
  @@index([severity]) WHERE status = 'NEW'             // Triage queue
  @@index([incidentId]) WHERE incidentId IS NOT NULL   // Incident alerts
  @@index([assignedToId]) WHERE status IN ('NEW', 'IN_PROGRESS')  // My alerts
  @@index([sourceIp])                                  // Investigation by IP
  @@index([mitreTechniques])                           // MITRE technique lookup
  @@map("alerts")
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  FALSE_POSITIVE
  SUPPRESSED
}

enum AlertType {
  DETECTION
  CORRELATION
  ANOMALY
  THREAT_FEED
  COMPLIANCE
  MANUAL
  TELECOM_FRAUD
}

// Incident table - core entity for IR workflow
model Incident {
  id                    UUID              @id @default(uuid())
  ticketNumber           String            @unique @map("ticket_number") @db.VarChar(20)
  title                 String            @db.VarChar(500) NOT NULL
  description           String?           @db.Text
  incidentType          IncidentType     @default(SECURITY)
  severity              IncidentSeverity @default(HIGH)
  status                IncidentStatus   @default(OPEN)
  phase                 IncidentPhase    @default(DETECTION)
  priority              Int              @default(3)
  
  // Scoring
  impactScore           Float            @default(0.0) @map("impact_score")
  confidenceScore       Float            @default(0.0) @map("confidence_score")
  
  // Assignment
  assignedToId          UUID?             @map("assigned_to_id")
  reportedBy            String?           @db.VarChar(100)
  team                  String?           @db.VarChar(100)
  
  // Classification
  tatcCode              String?           @map("tatc_code") @db.VarChar(20)  // Telecom Attack Taxonomy Code
  killChainPhase        String?           @map("kill_chain_phase") @db.VarChar(50)
  
  // Business impact
  affectedAssets        Json?             @map("affected_assets")  // Array of asset IDs/names
  affectedServices      Json?             @map("affected_services")
  affectedUsersCount    Int               @default(0) @map("affected_users_count")
  businessImpact        BusinessImpact   @default(MEDIUM)
  
  // Timeline
  detectedAt            DateTime          @default(now()) @map("detected_at")
  containmentTarget    DateTime?         @map("containment_target")
  resolutionTarget     DateTime?         @map("resolution_target")
  resolvedAt            DateTime?         @map("resolved_at")
  
  // Analysis
  rootCauseAnalysis     String?           @map("root_cause_analysis") @db.Text
  lessonsLearned        String?           @map("lessons_learned") @db.Text
  communicationLog      Json?             @map("communication_log")  // Array of comms entries
  
  // SLA tracking
  slaBreachRisk         Boolean           @default(false) @map("sla_breach_risk")
  slaBreachedAt         DateTime?         @map("sla_breached_at")
  
  // Tags and metadata
  tags                  String[]
  externalReferences    Json?             @map("external_references")  // Jira, ServiceNow tickets
  
  createdAt             DateTime          @default(now()) NOT NULL
  updatedAt             DateTime          @updatedAt

  // Relations
  assignedTo            User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  alerts                Alert[]
  tasks                 Task[]
  updates               IncidentUpdate[]
  evidence              Evidence[]
  iocs                  IncidentIOC[]
  timelineEvents        TimelineEvent[]

  @@index([status, severity])                          // Incident board
  @@index([assignedToId]) WHERE status != 'CLOSED'      // My open incidents
  @@index([detectedAt])                                // Time-range queries
  @@index([businessImpact]) WHERE status != 'CLOSED'    // Impact prioritization
  @@index([slaBreachRisk]) WHERE slaBreachRisk = true   // SLA warnings
  @@map("incidents")
}

enum IncidentType {
  SECURITY
  TELECOM_FRAUD
  DATA_BREACH
  COMPLIANCE
  PHYSICAL_SECURITY
  THIRD_PARTY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  TRIAGE
  IN_PROGRESS
  CONTAINED
  ERADICATED
  RECOVERY
  CLOSED
  ESCALATED
}

enum IncidentPhase {
  DETECTION
  ANALYSIS
  CONTAINMENT
  ERADICATION
  RECOVERY
  LESSONS_LEARNED
}

enum BusinessImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Incident updates (audit trail)
model IncidentUpdate {
  id          UUID      @id @default(uuid())
  incidentId  UUID      @map("incident_id")
  userId      UUID
  field       String    @db.VarChar(100)
  oldValue    Json?
  newValue    Json?
  comment     String?   @db.Text
  createdAt  DateTime  @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@index([incidentId])                            // Incident history
  @@index([createdAt])                             // Timeline
  @@map("incident_updates")
}

// Tasks for incident response playbooks
model Task {
  id            UUID        @id @default(uuid())
  incidentId    UUID        @map("incident_id")
  title         String      @db.VarChar(300) NOT NULL
  description  String?     @db.Text
  assigneeId    UUID?       @map("assignee_id")
  status        TaskStatus  @default(TODO)
  priority      TaskPriority @default(MEDIUM
  dueDate       DateTime?   @map("due_date")
  completedAt   DateTime?   @map("completed_at")
  checklist     Json?       // Array of sub-tasks
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  incident      Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignee      User?       @relation(fields: [assigneeId], references: [id])

  @@index([incidentId, status])                   // Incident task list
  @@index([assigneeId, status] WHERE status != 'COMPLETED')  // My tasks
  @@index([dueDate]) WHERE status != 'COMPLETED'     // Overdue tasks
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Evidence management
model Evidence {
  id            UUID          @id @default(uuid())
  incidentId    UUID          @map("incident_id")
  name          String        @db.VarChar(300) NOT NULL
  type          EvidenceType
  description   String?       @db.Text
  size          BigInt        @default(0)          // Size in bytes
  hashMd5       String?       @map("hash_md5") @db.VarChar(32)
  hashSha256    String?       @map("hash_sha256") @db.VarChar(64)
  storagePath   String?       @map("storage_path") @db.Text  // S3/minio path
  collectedBy   String        @db.VarChar(100)
  collectedAt   DateTime      @default(now()) @map("collected_at")
  isEncrypted   Boolean       @default(false) @map("is_encrypted")
  createdAt     DateTime      @default(now())

  incident      Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([type])
  @@map("evidence")
}

enum EvidenceType {
  LOG
  MEMORY_DUMP
  DISK_IMAGE
  PCAP
  SCREENSHOT
  REPORT
  MALWARE_SAMPLE
  EMAIL
  CONFIGURATION
  OTHER
}

// IOCs linked to incidents
model IncidentIOC {
  id            UUID      @id @default(uuid())
  incidentId    UUID      @map("incident_id")
  iocId         UUID      @map("ioc_id")  // Reference to central IOC table
  context       String?   @db.Text     // How this IOC relates to the incident
  confidence    Int       @default(0)   // Confidence specific to this incident
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  incident      Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_iocs")
}

// Timeline events for incidents
model TimelineEvent {
  id            UUID            @id @default(uuid())
  incidentId    UUID            @map("incident_id")
  type          TimelineEventType
  title         String          @db.VarChar(300) NOT NULL
  description   String?         @db.Text
  author        String          @db.VarChar(100)
  metadata      Json?           // Additional event-specific data
  createdAt     DateTime        @default(now())

  incident      Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])               // Incident timeline
  @@index([type])                                 // Event type filtering
  @@map("timeline_events")
}

enum TimelineEventType {
  DETECTION
  TRIAGE
  CONTAINMENT
  ERADICATION
  RECOVERY
  ESCALATION
  NOTIFICATION
  EVIDENCE
  NOTE
  STATUS_CHANGE
  TASK_COMPLETE
}

// ============================================================
// DOMAIN 3: SECURITY EVENTS (HIGH-VOLUME TIME-SERIES)
// Note: In production, this should be PARTITIONED by timestamp
// ============================================================

model SecurityEvent {
  id                  BigInt           @id @default(autoincrement())
  eventId             String?          @map("event_id") @db.VarChar(200)  // External event ID
  timestamp           DateTime         NOT NULL                     // Event occurrence time
  receivedAt          DateTime         @default(now()) @map("received_at")  // When we received it
  
  // Event classification
  eventType           String           @map("event_type") @db.VarChar(50) NOT NULL  // auth, network, endpoint, cloud, telecom
  category            String?          @db.VarChar(100)
  severity            String?          @db.VarChar(20)
  
  // Network context
  sourceIp            InetAddress?     @map("source_ip")
  destIp              InetAddress?     @map("dest_ip")
  sourcePort          Int?             @map("source_port")
  destPort            Int?             @map("dest_port")
  protocol            String?          @db.VarChar(20)
  
  // Entity context
  userId              String?          @map("user_id") @db.VarChar(100)
  userName            String?          @map("user_name") @db.VarChar(100)
  assetId             String?          @map("asset_id") @db.VarChar(100)
  assetName           String?          @map("asset_name") @db.VarChar(200)
  hostname            String?          @db.VarChar(255)
  
  // Raw and processed data
  rawLog              String?          @map("raw_log") @db.Text
  normalized          Json?            // Parsed and normalized fields
  
  // Processing status
  isProcessed         Boolean          @default(false) @map("is_processed")
  alertId             UUID?            @map("alert_id")  // Generated alert if any
  tags                String[]

  createdAt           DateTime         @default(now())

  // Indexes optimized for high-volume queries
  @@index([timestamp])                              // Primary time-range query
  @@index([timestamp, eventType])                    // Type-specific time ranges
  @@index([sourceIp, timestamp])                    // IP investigation
  @@index([eventType, severity]) WHERE isProcessed = true  // Processed events
  @@index([assetId, timestamp])                       // Asset timeline
  @@index([alertId]) WHERE alertId IS NOT NULL        // Events with alerts
  @@map("security_events")
}

// ============================================================
// DOMAIN 4: THREAT INTELLIGENCE (IOC DATABASE)
// ============================================================

model IOC {
  id                  UUID              @id @default(uuid())
  value               String            @db.VarChar(500) NOT NULL
  type                IOCType           NOT NULL
  confidence          Int               @default(0) CHECK (confidence BETWEEN 0 AND 100)
  source              String            @db.VarChar(100) NOT NULL
  threatType          String?           @map("threat_type") @db.VarChar(100)
  malwareFamily       String?           @map("malware_family") @db.VarChar(100)
  tlp                 TLPLevel          @default(AMBER)  // Traffic Light Protocol
  description         String?           @db.Text
  tags                String[]
  context             Json?             // Additional context from TI platform
  
  // Lifecycle
  firstSeen           DateTime?         @map("first_seen")
  lastSeen            DateTime?         @map("last_seen")
  expirationDate      DateTime?         @map("expiration_date")
  isActive            Boolean           @default(true) @map("is_active")
  
  // Enrichment data (cached from lookups)
  enrichmentData      Json?             @map("enrichment_data")  // GeoIP, WHOIS, VT score
  lastEnrichedAt      DateTime?         @map("last_enriched_at")
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Unique constraint on value + type for deduplication
  @@unique([value, type])
  @@index([type])                                   // Filter by IOC type
  @@index([isActive, type]) WHERE isActive = true   // Active IOCs only
  @@index([threatType]) WHERE isActive = true        // Threat type lookup
  @@index([source]) WHERE isActive = true            // Source-specific IOCs
  @@map("iocs")
}

enum IOCType {
  IP
  IP_RANGE
  DOMAIN
  URL
  HASH_MD5
  HASH_SHA1
  HASH_SHA256
  EMAIL
  PHONE
  IMSI
  IMEI
  FILENAME
  REGISTRY_KEY
  MUTEX
  CVE
  OTHER
}

enum TLPLevel {
  WHITE  // Public
  GREEN  // Community
  AMBER  // Limited distribution
  RED    // Not for sharing
}

// Threat Intelligence Sources configuration
model ThreatIntelSource {
  id                  UUID        @id @default(uuid())
  name                String      @db.VarChar(100) NOT NULL
  type                SourceType  NOT NULL
  apiUrl             String?     @map("api_url") @db.Text
  apiKeyEncrypted    String?     @map("api_key_encrypted") @db.Text
  isEnabled          Boolean     @default(true) @map("is_enabled")
  syncIntervalMinutes Int        @default(30) @map("sync_interval_minutes")
  lastSyncAt         DateTime?   @map("last_sync_at")
  lastSyncStatus     String?     @map("last_sync_status") @db.VarChar(20)
  lastSyncMessage    String?     @map("last_sync_message") @db.Text
  totalIOCsImported  Int         @default(0) @map("total_iocs_imported")
  config             Json?       // Source-specific configuration
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([isEnabled, type])
  @@map("threat_intel_sources")
}

enum SourceType {
  MISP
  THREATCONNECT
  ANOMALI
  VIRUSTOTAL
  ALIENVAULT
  OTX
  CUSTOM_FEED
  INTERNAL
}

// ============================================================
// DOMAIN 5: TELECOM-SPECIFIC (SIM Swap Fraud, Subscriber Data)
// ============================================================

model Subscriber {
  id                  UUID              @id @default(uuid())
  msisdn              String            @unique @db.VarChar(20) NOT NULL  // International format
  imsi                String?           @db.VarChar(20)
  imei                String?           @db.VarChar(20)
  subscriberType      String?           @map("subscriber_type") @db.VarChar(20)  // prepaid, postpaid, corporate
  status              SubscriberStatus  @default(ACTIVE)
  riskScore           Float             @default(0.0) @map("risk_score")  // ML-calculated fraud risk
  accountCreditLimit  Float?            @map("account_credit_limit")
  isHighValue         Boolean           @default(false) @map("is_high_value")  // VIP customer
  
  // Current location (from HLR/VLR)
  currentLocation     Json?             @map("current_location")  // {msc, vlr, lac, cell}
  roamingStatus       String?           @map("roaming_status") @db.VarChar(20)
  lastLocationUpdate  DateTime?        @map("last_location_update")
  
  // SIM information
  currentSimSerial    String?          @map("current_sim_serial") @db.VarChar(30)
  simHistory          Json?            @map("sim_history")  // Array of SIM changes
  
  // Account info
  retailLocationId    String?          @map("retail_location_id") @db.VarChar(20)
  accountCreatedDate  DateTime?        @map("account_created_date")
  lastActivityAt      DateTime?        @map("last_activity_at")
  
  // Notes
  notes               String?          @db.Text
  tags                String[]
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  simSwapEvents       SimSwapEvent[]
  fraudCases          TelecomFraudCase[]

  @@index([msisdn])                                 // Primary lookup
  @@index([imsi])                                    // IMSI lookup
  @@index([riskScore]) WHERE riskScore > 50          // High-risk subscribers
  @@index([status, riskScore])                      // Status + risk filtering
  @@index([currentSimSerial])                        // SIM serial lookup
  @@map("subscribers")
}

enum SubscriberStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PRE_ACTIVE
  ROAMING_ONLY
}

// SIM Swap Events - Critical for fraud detection
model SimSwapEvent {
  id                  UUID              @id @default(uuid())
  subscriberId        UUID              @map("subscriber_id")
  msisdn              String            @db.VarChar(20) NOT NULL
  
  // Old SIM info
  oldSimSerial        String?           @map("old_sim_serial") @db.VarChar(30)
  oldImsi             String?           @map("old_imsi") @db.VarChar(20)
  
  // New SIM info
  newSimSerial        String            @map("new_sim_serial") @db.VarChar(30) NOT NULL
  newImsi             String?           @map("new_imsi") @db.VarChar(20)
  
  // Transaction details
  channel             String            @db.VarChar(30) NOT NULL  // retail, app, ussd, api, dealer_portal
  retailLocationId    String?           @map("retail_location_id") @db.VarChar(20)
  employeeId          String?           @map("employee_id") @db.VarChar(20)
  verificationMethod String?          @map("verification_method") @db.VarChar(50)
  verificationDetails Json?           @map("verification_details")
  
  // Risk assessment
  isSuspicious        Boolean           @default(false) @map("is_suspicious")
  riskFactors         Json?             @map("risk_factors")  // Array of detected risk factors
  riskScore           Float             @default(0.0)
  mlAnalysisResult    Json?             @map("ml_analysis_result")
  
  // Resolution
  investigationStatus String?         @map("investigation_status") @db.VarChar(20)
  fraudCaseId         UUID?             @map("fraud_case_id")
  resolvedAt          DateTime?        @map("resolved_at")
  resolutionNotes     String?          @map("resolution_notes") @db.Text
  
  timestamp           DateTime          NOT NULL
  createdAt           DateTime          @default(now())

  subscriber          Subscriber       @relation(fields: [subscriberId], references: [id])

  @@index([msisdn, timestamp])                    // Subscriber SIM history
  @@index([timestamp])                               // Time-range queries
  @@index([channel, timestamp])                     // Channel analysis
  @@index([isSuspicious, timestamp])                // Suspicious swaps
  @@index([riskScore]) WHERE riskScore > 70          // High-risk swaps
  @@index([retailLocationId, timestamp])           // Location analysis
  @@map("sim_swap_events")
}

// Telecom Fraud Cases
model TelecomFraudCase {
  id                  UUID              @id @default(uuid())
  caseNumber          String            @unique @db.VarChar(20)
  caseType            FraudCaseType     NOT NULL
  title               String            @db.VarChar(500) NOT NULL
  description         String?           @db.Text
  status              FraudCaseStatus   @default(INVESTIGATING)
  priority            FraudPriority     @default(HIGH)
  severity            IncidentSeverity @default(HIGH)
  
  // Affected subscribers
  affectedMsisdns      String[]          @map("affected_msisdns")
  estimatedFinancialImpact Float?       @map("estimated_financial_impact")
  
  // Investigation
  assignedToId        UUID?             @map("assigned_to_id")
  investigatorNotes  Json?             @map("investigator_notes")
  
  // Timeline
  detectedAt          DateTime          @default(now()) @map("detected_at")
  resolvedAt          DateTime?         @map("resolved_at")
  
  // External references
  policeReportNumber  String?          @map("police_report_number") @db.VarChar(50)
  internalRefNumber   String?          @map("internal_ref_number") @db.VarChar(50)
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assignedTo          User?             @relation(fields: [assignedToId], references: [id])
  subscribers         Subscriber[]      @relation(fields: [id], references: [fraudCaseId])

  @@index([caseType, status])                       // Case management
  @@index([status, priority])                       // Prioritization
  @@index([detectedAt])                              // Time-range
  @@map("telecom_fraud_cases")
}

enum FraudCaseType {
  SIM_SWAP
  CLONING
  INTERCEPT
  PREMIUM_SERVICE_FRAUD
  ROAMING_FRAUD
  SUBSCRIPTION_FRAUD
  NETWORK_INTRUSION
  OTHER
}

enum FraudCaseStatus {
  DETECTED
  INVESTIGATING
  CONTAINED
  ESCALATED_TO_LAW_ENFORCEMENT
  RESOLVED
  DISMISSED_FALSE_POSITIVE
}

enum FraudPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  IMMEDIATE
}

// ============================================================
// DOMAIN 6: THREAT HUNTING (Phase 9 Component Support)
// ============================================================

model HuntSession {
  id                  UUID              @id @default(uuid())
  name                String            @db.VarChar(300) NOT NULL
  description         String?           @db.Text
  hypothesis         String            @db.Text NOT NULL
  status              HuntSessionStatus @default(DRAFT)
  hunterId            UUID              NOT NULL
  
  // Statistics
  totalQueries        Int               @default(0) @map("total_queries")
  totalFindings       Int               @default(0) @map("total_findings")
  totalIOCsExtracted  Int               @default(0) @map("total_iocs_extracted")
  
  // Time tracking
  startedAt           DateTime?         @map("started_at")
  completedAt         DateTime?         @map("completed_at")
  durationSeconds     Int?              @map("duration_seconds")
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  hunter              User              @relation(fields: [hunterId], references: [id])
  queries             HuntQuery[]
  findings            HuntFinding[]

  @@index([hunterId, status])                      // My hunting sessions
  @@index([status])                               // Active sessions
  @@map("hunt_sessions")
}

enum HuntSessionStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model HuntQuery {
  id                  UUID              @id @default(uuid())
  sessionId           UUID              @map("session_id")
  name                String            @db.VarChar(300) NOT NULL
  queryType           QueryType         NOT NULL
  queryString         String            @db.Text NOT NULL
  dataSource          String            @db.VarChar(100) NOT NULL
  
  // Results
  resultCount         Int               @default(0) @map("result_count")
  executionTimeMs     Int               @default(0) @map("execution_time_ms")
  status              QueryStatus       @default(PENDING)
  errorMessage       String?           @map("error_message") @db.Text
  
  executedAt          DateTime?         @map("executed_at")
  cachedResults       Json?             @map("cached_results")  // Cache query results for re-use
  
  createdAt           DateTime          @default(now())

  session             HuntSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])                             // Session queries
  @@index([queryType])                             // Query type filtering
  @@index([dataSource])                            // Data source filtering
  @@map("hunt_queries")
}

enum QueryType {
  LUCENE
  SQL
  SIGMA
  YARA
  KQL
  SPLUNK_SPL
  CUSTOM
}

enum QueryStatus {
  PENDING
  RUNNING
  COMPLETED
  ERROR
  CANCELLED
}

model HuntFinding {
  id                  UUID              @id @default(uuid())
  sessionId           UUID              @map("session_id")
  queryId             UUID              @map("query_id")
  title               String            @db.VarChar(500) NOT NULL
  description         String?           @db.Text
  severity            FindingSeverity  @default(MEDIUM)
  confidence          Int               @default(0) CHECK (confidence BETWEEN 0 AND 100)
  status              FindingStatus    @default(NEW)
  
  // Evidence
  rawEvidence         Json?
  iocs                Json?             // Array of extracted IOCs
  
  // Correlation
  relatedAlertIds      UUID[]           @map("related_alert_ids")
  relatedIncidentIds  UUID[]           @map("related_incident_ids")
  
  // Assignment
  assignedToId        UUID?             @map("assigned_to_id")
  escalatedToIncident Boolean          @default(false) @map("escalated_to_incident")
  incidentId          UUID?             @map("incident_id")
  
  timestamp           DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  session             HuntSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedTo          User?             @relation("FindingAssignee", fields: [assignedToId], references: [id])

  @@index([sessionId, severity])                   // Session findings sorted by severity
  @@index([status, confidence]) WHERE sessionId = $sessionId  // Triage
  @@index([escalatedToIncident]) WHERE escalatedToIncident = true  // Escalated findings
  @@map("hunt_findings")
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  NEW
  INVESTIGATING
  CONFIRMED
  FALSE_POSITIVE
  ESCALATED
  CLOSED
}

// ============================================================
// DOMAIN 7: AUTOMATION & SOAR (Playbooks, Workflows)
// ============================================================

model Playbook {
  id                  UUID              @id @default(uuid())
  name                String            @db.VarChar(200) NOT NULL UNIQUE
  description         String?           @db.Text
  category            PlaybookCategory  NOT NULL
  version             Int               @default(1)
  isEnabled           Boolean           @default(true) @map("is_enabled")
  
  // Trigger conditions
  triggers            Json?             // When to auto-execute
  
  // Steps (ordered)
  steps               Json              NOT NULL  // Array of step objects
  
  // Metadata
  author              String            @db.VarChar(100)
  ownerTeam           String?           @map("owner_team") @db.VarChar(100)
  tags                String[]
  
  // Execution stats
  totalRuns           Int               @default(0) @map("total_runs")
  successRate         Float             @default(0.0) @map("success_rate")
  avgRuntimeMinutes   Float?            @map("avg_runtime_minutes")
  lastRunAt           DateTime?         @map("last_run_at")
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([category, isEnabled])                 // Category listing
  @@index([name])                                  // Search
  @@map("playbooks")
}

enum PlaybookCategory {
  CONTAINMENT
  ERADICATION
  INVESTIGATION
  ENRICHMENT
  NOTIFICATION
  TELECOM_FRAUD
  COMPLIANCE
  GENERAL
}

model PlaybookRun {
  id                  UUID              @id @default(uuid())
  playbookId          UUID              @map("playbook_id")
  incidentId          UUID?             @map("incident_id")
  triggeredBy         String            @db.VarChar(100)  // User or automation
  triggeredByAlertId  UUID?             @map("triggered_by_alert_id")
  
  status              RunStatus         @default(RUNNING)
  currentStep         Int               @default(0) @map("current_step")
  totalSteps          Int               @default(0) @map("total_steps")
  
  // Results
  results             Json?             // Step-by-step results
  artifacts           Json?             // Created artifacts (tickets, blocks, etc.)
  errorMessage       String?           @map("error_message") @db.Text
  
  startedAt           DateTime          @default(now())
  completedAt         DateTime?         @map("completed_at")
  durationSeconds     Int?              @map("duration_seconds")
  
  createdAt           DateTime          @default(now())

  playbook            Playbook          @relation(fields: [playbookId], references: [id])

  @@index([playbookId, status])                    // Playbook run history
  @@index([incidentId])                           // Incident runs
  @@index([status, startedAt])                     // Active runs
  @@map("playbook_runs")
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL_SUCCESS
}

// ============================================================
// DOMAIN 8: AUDIT LOGGING & COMPLIANCE
// ============================================================

model AuditLog {
  id                  UUID              @id @default(uuid())
  userId              UUID?
  action              String            @db.VarChar(100) NOT NULL
  resourceType        String            @map("resource_type") @db.VarChar(100) NOT NULL
  resourceId          String            @map("resource_id") @db.VarChar(200) NOT NULL
  oldValue           Json?
  newValue           Json?
  ipAddress          InetAddress?      @map("ip_address")
  userAgent          String?           @map("user_agent") @db.Text
  sessionToken        String?           @map("session_token") @db.VarChar(64)
  
  // Result
  isSuccess           Boolean           @default(true) @map("is_success")
  errorMessage       String?           @map("error_message") @db.Text
  
  // Metadata
  correlationId       String?           @map("correlation_id") @db.VarChar(100)  // Request tracing
  metadata            Json?
  
  createdAt           DateTime          @default(now())

  @@index([userId])                                 // User activity
  @@index([resourceType, resourceId])             // Resource audit trail
  @@index([action])                                  // Action type filtering
  @@index([createdAt])                               // Time-range queries
  @@index([ipAddress])                               // Security: actions from IP
  @@map("audit_logs")
}

// ============================================================
// DOMAIN 9: SYSTEM CONFIGURATION
// ============================================================

model SystemConfig {
  id                  UUID              @id @default(uuid())
  category            String            @db.VarChar(100) NOT NULL
  key                 String            @db.VarChar(200) NOT NULL
  value               Json             NOT NULL
  description         String?           @db.Text
  isEncrypted         Boolean           @default(false) @map("is_encrypted")
  lastModifiedBy      String?           @map("last_modified_by") @db.VarChar(100)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([category, key])
  @@index([category])
  @@map("system_config")
}

// Suppression rules to reduce noise
model SuppressionRule {
  id                  UUID              @id @default(uuid())
  name                String            @db.VarChar(200) NOT NULL
  description         String?           @db.Text
  isEnabled           Boolean           @default(true) @map("is_enabled")
  
  // Match conditions (JSON logic tree)
  conditions          Json             NOT NULL  // {field, operator, value} structure
  
  // Actions when matched
  suppressDuration   Int?              @map("suppress_duration_minutes")  // 0 = permanent
  applyTag            String?           @map("apply_tag") @db.VarChar(100)
  setSeverity         String?           @map("set_severity") @db.VarChar(20)
  autoResolve        Boolean           @default(false) @map("auto_resolve")
  
  // Stats
  matchCount          Int               @default(0) @map("match_count")
  lastMatchedAt       DateTime?         @map("last_matched_at")
  createdBy           String            @db.VarChar(100)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([isEnabled, name])
  @@map("suppression_rules")
}
