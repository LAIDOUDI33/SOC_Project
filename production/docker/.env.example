# 🇩🇿 National SOC Production Environment Configuration
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ═══════════════════════════════════════════════════════════
# SECURITY WARNING: Keep these credentials secure!
# Use strong, unique passwords for each service.
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# POSTGRESQL DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────
POSTGRES_DB=soc_production
POSTGRES_USER=soc_admin
# Generate with: openssl rand -base64 32 | tr -d '\n'
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD_64chars
POSTGRES_PORT=5432

# ───────────────────────────────────────────────────────────
# REDIS CACHE CONFIGURATION
# ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_64_HEX_CHARS
REDIS_PORT=6379

# ───────────────────────────────────────────────────────────
# MINIO OBJECT STORAGE CONFIGURATION
# ───────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=socadmin
# Minimum 8 characters
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET_8_CHARS_MIN
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ───────────────────────────────────────────────────────────
# DEVELOPMENT TOOLS (Only loaded with --profile development)
# ───────────────────────────────────────────────────────────
ADMINER_PORT=8080
REDIS_CMD_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# ───────────────────────────────────────────────────────────
# SSL/TLS CERTIFICATES (Let's Encrypt)
# ───────────────────────────────────────────────────────────
SSL_DOMAIN=soc.dz
SSL_EMAIL=admin@soc.dz
SSL_STAGING=false  # Set to true for testing

# ───────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ───────────────────────────────────────────────────────────
NODE_ENV=production
NEXTAUTH_URL=https://soc.dz
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_JWT_SECRET_FOR_TOKEN_SIGNING

# ───────────────────────────────────────────────────────────
# INTEGRATION API KEYS (Configure per tool)
# ───────────────────────────────────────────────────────────
WAZUH_API_URL=https://wazuh.soc.dz:55000
WAZUH_API_USERNAME=wazuh
WAZUH_API_PASSWORD=CHANGE_ME_WAZUh_PASSWORD

THEHIVE_API_URL=https://thehive.soc.dz:9000
THEHIVE_API_KEY=CHANGE_ME_THEHIVE_API_KEY_64CHARS

MISP_API_URL=https://misp.soc.dz:443
MISP_API_KEY=CHANGE_ME_MISP_API_KEY_32CHARS

SURICATA_API_URL=http://suricata.soc.dz:8080
SURICATA_API_KEY=CHANGE_ME_SURICATA_API_KEY

ELASTICSEARCH_URL=https://elasticsearch.soc.dz:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD

GRAFANA_URL=https://grafana.soc.dz:3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ───────────────────────────────────────────────────────────
# VOLUME PATHS (Customize for your environment)
# ───────────────────────────────────────────────────────────
VOLUME_PATH=/opt/soc/data
SSL_PATH=/opt/soc/ssl
LOG_PATH=/opt/soc/logs

# ───────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=  # Optional: Error tracking URL
ENABLE_METRICS=true

# ───────────────────────────────────────────────────────────
# BACKUP CONFIGURATION
# ───────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00  # UTC time for daily backups
S3_BACKUP_BUCKET=  # Optional: Remote backup destination
