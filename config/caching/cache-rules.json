{"version": "2.0.0", "name": "Djezzy SOC Platform Cache Rules", "description": "TTL policies and caching rules by data type for multi-layer cache architecture", "target_metrics": {"cache_hit_rate_target": 0.95, "p95_latency_ms": 5, "max_memory_usage_percent": 85}, "rules": {"authentication_and_security": {"category": "Authentication & Security", "priority": "critical", "default_ttl_seconds": 1800, "max_ttl_seconds": 3600, "allow_cdn_cache": false, "allow_browser_cache": false, "invalidate_on_change": true, "entries": {"auth_tokens": {"pattern": "auth:token:*", "ttl_seconds": 1800, "sliding_expiration": true, "refresh_on_access": true, "storage": "redis_l3"}, "user_sessions": {"pattern": "sess:user:*", "ttl_seconds": 3600, "absolute_timeout_seconds": 28800, "activity_tracking": true, "storage": "redis_l3"}, "mfa_state": {"pattern": "mfa:*", "ttl_seconds": 300, "single_use_attempts": 3, "storage": "redis_l3"}, "csrf_tokens": {"pattern": "csrf:*", "ttl_seconds": 3600, "rotate_on_use": true, "storage": "redis_l3"}, "rate_limit_counters": {"pattern": "rl:*", "ttl_seconds": 60, "sliding_window": true, "storage": "redis_l3"}, "permission_cache": {"pattern": "uperm:*", "ttl_seconds": 600, "tags": ["user:{user_id}", "permissions"], "storage": "redis_l3"}}}, "realtime_operational_data": {"category": "Real-Time Operational Data", "priority": "high", "default_ttl_seconds": 60, "max_ttl_seconds": 300, "allow_cdn_cache": false, "cdn_ttl_seconds": 30, "allow_browser_cache": true, "browser_ttl_seconds": 15, "entries": {"active_alerts": {"pattern": "alert:active:*", "ttl_seconds": 30, "strategy": "write_through", "invalidation": "event_driven", "tags": ["alerts", "active"], "storage": "redis_l3", "swr_seconds": 10}, "alert_details": {"pattern": "alert:{id}:detail", "ttl_seconds": 300, "background_refresh": true, "tags": ["alert:{id}", "alert_details"], "storage": "redis_l3", "cdn_ttl_seconds": 60}, "alert_counts": {"pattern": "alertcnt:*", "ttl_seconds": 30, "granularity": "1m", "storage": "redis_l3", "swr_seconds": 10}, "incident_list": {"pattern": "inc:list:*", "ttl_seconds": 120, "strategy": "cache_aside", "tags": ["incidents", "list"], "storage": "redis_l3", "cdn_ttl_seconds": 60}, "incident_details": {"pattern": "inc:{id}:*", "ttl_seconds": 600, "tags": ["incident:{id}"], "storage": "redis_l3", "cdn_ttl_seconds": 120}, "incident_timeline": {"pattern": "inctl:{id}:*", "ttl_seconds": 300, "tags": ["incident:{id}", "timeline"], "storage": "redis_l3"}, "event_counts": {"pattern": "evtagg:*", "ttl_seconds": 60, "granularity": "1m", "storage": "redis_l3", "cdn_ttl_seconds": 30}, "event_stream_buffer": {"pattern": "evt:stream:*", "ttl_seconds": 60, "max_items": 1000, "storage": "redis_l3", "no_cache": true}, "system_health_status": {"pattern": "system:health:*", "ttl_seconds": 15, "strategy": "write_through", "storage": "redis_l3", "swr_seconds": 5}}}, "analytics_and_metrics": {"category": "Analytics & Metrics", "priority": "high", "default_ttl_seconds": 300, "max_ttl_seconds": 3600, "allow_cdn_cache": true, "cdn_ttl_seconds": 120, "allow_browser_cache": true, "browser_ttl_seconds": 60, "entries": {"dashboard_kpis": {"pattern": "kpi:*", "ttl_seconds": 300, "aggregation_window": "5m", "refresh_schedule": "*/5 * * * *", "tags": ["kpis", "dashboard"], "storage": "redis_l3", "cdn_ttl_seconds": 120}, "dashboard_widgets": {"pattern": "dw:*", "ttl_seconds": 60, "refresh_schedule": "* * * * *", "tags": ["widgets", "dashboard"], "storage": "redis_l3", "cdn_ttl_seconds": 30, "swr_seconds": 15}, "metrics_summary": {"pattern": "metric:summary:*", "ttl_seconds": 60, "granularity": "5m", "storage": "redis_l3", "cdn_ttl_seconds": 30}, "historical_trends": {"pattern": "metric:trend:*", "ttl_seconds": 1800, "granularity": "hourly", "storage": "redis_l3", "cdn_ttl_seconds": 900}, "correlation_results": {"pattern": "corr:*", "ttl_seconds": 600, "storage": "redis_l3", "no_cdn": true}, "ml_anomaly_scores": {"pattern": "ml:anomaly:*", "ttl_seconds": 900, "model_version_aware": true, "storage": "redis_l3", "cdn_ttl_seconds": 300}, "ml_predictions": {"pattern": "ml:pred:*", "ttl_seconds": 900, "model_version_aware": true, "storage": "redis_l3", "cdn_ttl_seconds": 300}, "threat_scores": {"pattern": "score:threat:*", "ttl_seconds": 300, "storage": "redis_l3", "cdn_ttl_seconds": 120}}}, "reference_data": {"category": "Reference Data", "priority": "medium", "default_ttl_seconds": 86400, "max_ttl_seconds": 604800, "allow_cdn_cache": true, "cdn_ttl_seconds": 43200, "allow_browser_cache": true, "browser_ttl_seconds": 3600, "preload_at_startup": true, "entries": {"lookup_tables": {"pattern": "lookup:*", "ttl_seconds": 86400, "strategy": "eager_loading", "preload": true, "storage": "redis_l3", "cdn_ttl_seconds": 86400}, "geoip_database": {"pattern": "geo:*", "ttl_seconds": 604800, "bulk_load": true, "storage": "redis_l3", "cdn_ttl_seconds": 604800}, "threat_intel_iocs": {"pattern": "tioc:*", "ttl_seconds": 3600, "incremental_updates": true, "external_source": true, "storage": "redis_l3", "cdn_ttl_seconds": 1800}, "threat_actors": {"pattern": "ti:actor:*", "ttl_seconds": 86400, "storage": "redis_l3", "cdn_ttl_seconds": 21600}, "mitre_attack_data": {"pattern": "mitre:*", "ttl_seconds": 43200, "versioned": true, "storage": "redis_l3", "cdn_ttl_seconds": 43200}, "compliance_frameworks": {"pattern": "comp:fw:*", "ttl_seconds": 43200, "version_aware": true, "storage": "redis_l3", "cdn_ttl_seconds": 21600}, "compliance_controls": {"pattern": "comp:ctrl:*", "ttl_seconds": 43200, "storage": "redis_l3", "cdn_ttl_seconds": 21600}, "user_directory": {"pattern": "user:dir:*", "ttl_seconds": 3600, "sync_with_ldap": true, "storage": "redis_l3", "cdn_ttl_seconds": 1800}, "playbooks": {"pattern": "pb:*", "ttl_seconds": 86400, "version_controlled": true, "storage": "redis_l3", "cdn_ttl_seconds": 43200}, "runbook_templates": {"pattern": "rbt:*", "ttl_seconds": 43200, "storage": "redis_l3", "cdn_ttl_seconds": 21600}, "notification_templates": {"pattern": "notif:tmpl:*", "ttl_seconds": 86400, "storage": "redis_l3", "cdn_ttl_seconds": 43200}}}}, "invalidation_rules": {"strategies": {"immediate_pubsub": {"description": "Invalidate immediately via Redis pub/sub on data change", "trigger_channels": ["cache:invalidate", "soc:{entity}:changed"], "applicable_to": ["active_alerts", "alert_details", "alert_counts", "incident_details", "incident_timeline", "user_sessions", "permission_cache"]}, "time_based_expiry": {"description": "Allow natural TTL expiration", "applicable_to": ["historical_trends", "metrics_summary", "threat_intel_iocs"]}, "version_key": {"description": "Increment version key for atomic group invalidation", "key_prefix": "cacheversion:", "applicable_to": ["dashboard_widgets", "dashboard_kpis", "playbooks"]}, "tag_invalidation": {"description": "Invalidate all keys matching specified tags", "max_tags_per_key": 50, "applicable_to": ["alert_details", "incident_details", "incident_timeline"]}}, "event_triggers": {"alert_created": {"actions": [{"type": "invalidate_pattern", "pattern": "alert:*:list:*"}, {"type": "increment_version", "key": "cacheversion:alerts"}, {"type": "publish", "channel": "alerts:updated"}]}, "alert_updated": {"actions": [{"type": "invalidate_pattern", "pattern": "alert:{id}:*"}, {"type": "invalidate_pattern", "pattern": "alert:*:summary:*"}, {"type": "publish", "channel": "alert:{id}:updated"}]}, "alert_acknowledged": {"actions": [{"type": "invalidate_pattern", "pattern": "alert:*:active:*"}, {"type": "invalidate_pattern", "pattern": "alertcnt:*"}]}, "incident_created": {"actions": [{"type": "invalidate_pattern", "pattern": "inc:*:list:*"}, {"type": "invalidate_pattern", "pattern": "metric:*:incident_count:*"}, {"type": "increment_version", "key": "cacheversion:incidents"}]}, "incident_status_changed": {"actions": [{"type": "invalidate_pattern", "pattern": "inc:{id}:*"}, {"type": "invalidate_pattern", "pattern": "inc:*:status:*"}, {"type": "invalidate_pattern", "pattern": "kpi:*:incidents:*"}]}, "user_permission_changed": {"actions": [{"type": "invalidate_pattern", "pattern": "user:{user_id}:perm:*"}, {"type": "invalidate_pattern", "pattern": "user:{user_id}:roles:*"}]}, "threat_intel_updated": {"actions": [{"type": "invalidate_pattern", "pattern": "tioc:{type}:{value}:*"}]}, "compliance_check_completed": {"actions": [{"type": "invalidate_pattern", "pattern": "comp:*:status:*"}, {"type": "invalidate_pattern", "pattern": "comp:*:score:*"}]}}}, "cache_warming": {"enabled": true, "jobs": [{"name": "warm_dashboard_widgets", "schedule": "*/1 * * * *", "queries": ["SELECT * FROM dashboard_widget_configs WHERE active = true", "SELECT metric_type, value FROM kpi_snapshots ORDER BY created_at DESC LIMIT 50"], "target_patterns": ["dw:*", "kpi:*"], "priority": "high"}, {"name": "warm_reference_data", "schedule": "0 */6 * * *", "queries": ["SELECT * FROM lookup_tables WHERE status = 'active'", "SELECT * FROM threat_actors WHERE is_active = true"], "target_patterns": ["lookup:*", "ti:actor:*"], "priority": "medium"}, {"name": "warm_compliance_data", "schedule": "0 3 * * *", "queries": ["SELECT framework_id, control_id, status FROM compliance_status"], "target_patterns": ["comp:*"], "priority": "low"}]}, "monitoring": {"metrics_to_track": ["cache_hit_rate", "cache_miss_rate", "avg_lookup_time_ms", "p95_lookup_time_ms", "p99_lookup_time_ms", "memory_usage_bytes", "evicted_keys_total", "expired_keys_total", "keys_total", "connections_active"], "alerting_rules": {"cache_hit_rate_low": {"condition": "cache_hit_rate < 0.90", "duration": "5m", "severity": "warning", "message": "Cache hit rate dropped below 90%"}, "cache_hit_rate_critical": {"condition": "cache_hit_rate < 0.80", "duration": "2m", "severity": "critical", "message": "CRITICAL: Cache hit rate below 80% - investigate immediately"}, "high_latency_p99": {"condition": "p99_lookup_time_ms > 20", "duration": "3m", "severity": "warning", "message": "Cache P99 latency exceeds 20ms"}, "memory_pressure": {"condition": "memory_usage_percent > 85", "duration": "5m", "severity": "warning", "message": "Redis memory usage above 85%"}, "critical_memory": {"condition": "memory_usage_percent > 95", "duration": "1m", "severity": "critical", "message": "CRITICAL: Redis memory usage critical - immediate action required"}, "high_eviction_rate": {"condition": "evicted_keys_per_second > 1000", "duration": "2m", "severity": "warning", "message": "High key eviction rate detected"}}}