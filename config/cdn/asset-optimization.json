{"version": "1.0", "description": "Static asset optimization settings for Djezzy SOC Platform", "images": {"formats": {"primary": ["image/avif", "image/webp"], "fallback": "image/png", "svg": true}, "optimization": {"enabled": true, "quality": 85, "progressive_jpeg": true, "strip_metadata": true, "preserve_exif": false}, "responsive": {"enabled": true, "sizes": [{"name": "xs", "width": 375, "use_case": "mobile_portrait"}, {"name": "sm", "width": 640, "use_case": "mobile_landscape"}, {"name": "md", "width": 768, "use_case": "tablet_portrait"}, {"name": "lg", "width": 1024, "use_case": "tablet_landscape"}, {"name": "xl", "width": 1280, "use_case": "desktop_small"}, {"name": "2xl", "width": 1536, "use_case": "desktop_large"}], "device_pixel_ratios": [1, 2, 3], "lazy_load_threshold": "1250px"}, "cdn_settings": {"domain": "cdn.djezzy.dz", "subdomain": "static.djezzy.dz", "path_prefix": "/_soc/assets/", "versioning": "query_string", "cache_headers": {"Cache-Control": "public, max-age=31536000, immutable", "Expires": "", "Vary": "Accept-Encoding"}}}, "javascript": {"bundling": {"enabled": true, "minify": true, "source_maps": false, "tree_shaking": true, "code_splitting": {"enabled": true, "strategy": "route_based", "chunks": ["vendor", "common", "dashboard", "alerts", "incidents", "analytics", "settings"]}}, "optimization": {"module_concatenation": true, "side_effects": true, "used_exports": true, "analyze": process.env.ANALYZE === "true"}, "headers": {"Content-Type": "application/javascript; charset=utf-8", "X-Content-Type-Options": "nosniff"}}, "css": {"processing": {"enabled": true, "minify": true, "autoprefixer": true, "purge_unused": true, "rtl_support": false}, "critical_css": {"enabled": true, "inline_critical": true, "async_non_critical": true}, "variables": {"theme_colors": {"primary": "#dc2626", "secondary": "#1e40af", "success": "#16a34a", "warning": "#ca8a04", "danger": "#dc2626", "background": "#ffffff", "foreground": "#0f172a"}}}, "fonts": {"strategy": "self_