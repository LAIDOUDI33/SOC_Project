{"version": "2.0.0", "name": "Djezzy SOC Platform DDoS Protection & Rate Limiting", "description": "Comprehensive DDoS protection, rate limiting, and WAF rules for SOC platform", "platform_info": {"name": "Djezzy National SOC Platform", "environment": "production", "criticality": "national-infrastructure"}, "general_settings": {"protection_enabled": true, "security_level": "high", "challenge_passage": 1800, "browser_integrity_check": true, "hotlink_protection": false, "always_online": true, "under_attack_mode": false}, "rate_limiting": {"enabled": true, "global_settings": {"requests_per_period_default": 10000, "period_seconds_default": 60, "action_default": "throttle", "timeout_default": 60}, "rules": [{"id": "rl-001", "name": "Global Rate Limit - All Requests", "description": "Base rate limit for all requests to prevent abuse", "enabled": true, "expression": "true", "priority": 1, "action": {"mode": "simulate", "timeout": 60, "response": {"status": 429, "content_type": "application/json", "body": "{\"error\": \"Rate limit exceeded\", \"message\": \"Too many requests, please slow down\", \"retryAfter\": 60}", "headers": {"Retry-After": "60"}}}, "thresholds": {"requests_per_period": 10000, "period_seconds": 60, "burst_allowance": 500}}, {"id": "rl-002", "name": "API Rate Limit - Strict", "description": "Stricter limits for API endpoints to protect backend services", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api\") && !(http.request.uri.path starts_with \"/api/v1/events\")", "priority": 2, "action": {"mode": "block", "timeout": 300, "response": {"status": 429, "content_type": "application/json", "body": "{\"error\": \"API rate limit exceeded\", \"message\": \"API rate limit of 5000 req/min exceeded\", \"retryAfter\": 300}"}}, "thresholds": {"requests_per_period": 5000, "period_seconds": 60, "burst_allowance": 200}}, {"id": "rl-003", "name": "Authentication Rate Limit - Very Strict", "description": "Strict limits on auth endpoints to prevent brute force attacks", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api/auth\") || (http.request.uri.path contains \"/login\") || (http.request.uri.path contains \"/oauth\") || (http.request.uri.path contains \"/saml\")", "priority": 3, "action": {"mode": "block", "timeout": 900, "response": {"status": 429, "content_type": "application/json", "body": "{\"error\": \"Authentication rate limit exceeded\", \"message\": \"Too many authentication attempts, please wait\"}"}}, "thresholds": {"requests_per_period": 20, "period_seconds": 60, "burst_allowance": 5}}, {"id": "rl-004", "name": "Event Ingestion Limit - High Throughput", "description": "High limit for legitimate event ingestion traffic from collectors", "enabled": true, "expression": "(http.request.uri.path eq \"/api/v1/events\") || (http.request.uri.path eq \"/api/v1/events/batch\") && (http.request.method eq \"POST\")", "priority": 4, "action": {"mode": "throttle", "timeout": 10, "response": {"status": 202, "content_type": "application/json", "body": "{\"queued\": true, \"message\": \"Event accepted and queued for processing\"}"}}, "thresholds": {"requests_per_period": 600000, "period_seconds": 60, "burst_allowance": 10000}}, {"id": "rl-005", "name": "Dashboard Load Limit", "description": "Rate limiting for dashboard page loads to prevent abuse", "enabled": true, "expression": "(http.request.uri.path eq \"/\") || (http.request.uri.path starts_with \"/dashboard\") || (http.request.uri.path starts_with \"/dashboards/\")", "priority": 5, "action": {"mode": "throttle", "timeout": 30, "response": {"status": 200, "headers": {"X-RateLimit-Limited": "true"}}}, "thresholds": {"requests_per_period": 120, "period_seconds": 60, "burst_allowance": 20}}, {"id": "rl-006", "name": "Streaming/SSE Connection Limit", "description": "Limit concurrent streaming connections per IP", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api/stream\") || (http.request.uri.path contains \"/sse\")", "priority": 6, "action": {"mode": "block", "timeout": 300, "response": {"status": 429, "content_type": "text/event-stream", "data": "event: error\ndata: Too many streaming connections\n\n"}}, "thresholds": {"requests_per_period": 10, "period_seconds": 60, "concurrent_connections_per_ip": 5}}]}, "ddos_protection": {"layers": {"l3_l4_protection": {"enabled": true, "mitigation_types": ["syn_flood", "udp_flood", "icmp_flood", "amplification", "reflection"], "thresholds_mbps": 10000, "thresholds_pps": 5000000, "thresholds_new_connections_per_second": 100000, "action": "mitigate", "scrubbing_center_enabled": true}, "l7_protection": {"enabled": true, "rules": [{"id": "ddos-l7-001", "name": "HTTP Flood Protection", "description": "Detect and mitigate HTTP/HTTPS flood attacks using behavioral analysis", "enabled": true, "expression": "(cf.threat_score gt 50) || (cf.client.risk_score gt 80)", "action": {"mode": "managed_challenge"}, "sensitivity": "high", "thresholds": {"requests_per_10_seconds": 1000, "requests_per_minute": 5000}}, {"id": "ddos-l7-002", "name": "Slowloris Protection", "description": "Protect against slow connection/DoS attacks", "enabled": true, "expression": "(cf.connection.established gt 30) && (cf.threat_score gt 30)", "action": {"mode": "connection_close"}, "max_connection_duration_seconds": 30, "min_request_rate_per_connection": 2}, {"id": "ddos-l7-003", "name": "Request Size Limit", "description": "Block abnormally large requests that could cause OOM", "enabled": true, "expression": "(http.request.body.size.bytes gt 10485760)", "action": {"mode": "block", "response": {"status": 413, "content_type": "application/json", "body": "{\"error\": \"Request entity too large\", \"maxSize\": \"10MB\"}"}}, {"id": "ddos-l7-004", "name": "Suspicious User Agent Blocking", "description": "Block requests with known malicious/scanning user agents", "enabled": true, "expression": "(http.user_agent contains \"sqlmap\") || (http.user_agent contains \"nikto\") || (http.user_agent contains \"nmap\") || (http.user_agent contains \"masscan\") || (http.user_agent contains \"gobuster\") || (http.user_agent contains \"dirbuster\") || (http.user_agent contains \"wfuzz\") || (http.user_agent contains \"hydra\") || ((http.user_agent contains \"python-requests\") && !(http.request.uri.path starts_with \"/api/v1/events\"))", "action": {"mode": "block", "response": {"status": 403, "body": "Access Denied"}}, {"id": "ddos-l7-005", "name": "Abnormal Header Patterns", "description": "Detect requests with suspicious header patterns", "enabled": true, "expression": "(http.request.headers[\"X-Forwarded-For\"] count gt 10) || (contains(http.request.headers[\"User-Agent\"], \"bot\")) || (length(http.request.headers[\"Cookie\"]) gt 10000)", "action": {"mode": "managed_challenge"}}]}}, "bot_management": {"enabled": true, "fight_mode": false, "super_bot_fight_mode": false, "session_identification": {"enabled": true, "cookie_name": "__soc_bm_session", "ttl": 86400}, "rules": [{"id": "bot-001", "name": "Block Known Malicious Bots", "expression": "(cf.client.bot) && (cf.bot_management.score lt 30)", "action": "block", "enabled": true}, {"id": "bot-002", "name": "Challenge Suspicious Bots", "expression": "(cf.bot_management.score ge 30) && (cf.bot_management.score lt 50)", "action": "managed_challenge", "enabled": true}, {"id": "bot-003", "name": "Allow Verified Search Engine Bots", "expression": "(cf.client.bot) && (cf.verified_bot_category in {\"search_engine\", \"monitoring\"})", "action": "skip", "enabled": true}, {"id": "bot-004", "name": "Rate Limit Unknown Bots", "expression": "(cf.bot_management.score lt 80) && (!cf.verified_bot)", "action": "throttle", "enabled": true}]}}}, "waf_rules": {"enabled": true, "rule_sets": ["cloudflare_managed_rulesets", "owasp_core_rule_set_v3.3"], "managed_rules": [{"id": "efb3bfe9-6e43-4c2f-babc-1a48d97d3e5f", "name": "Cloudflare Specials", "action": "block", "severity": "high", "enabled": true}, {"id": "4814384a-6207-4bf3-926b-cedca367590d", "name": "OWASP CRS Level 1 (Anomaly High)", "action": "block", "severity": "high", "enabled": true}], "custom_rules": [{"id": "waf-custom-001", "name": "SQL Injection Protection", "description": "Block common SQL injection patterns in query strings and body", "enabled": true, "expression": "(http.request.uri.query contains \"'\") || (http.request.uri.query contains \"OR 1=1\") || (http.request.uri.query contains \"UNION SELECT\") || (http.request.uri.query contains \"--;\") || (http.request.body contains \"' OR '\") || (http.request.body contains \"'; DROP\") || (http.request.body contains \"UNION+SELECT\")", "action": "block", "logging": {"enabled": true, "metadata": {"rule_id": "SQLI-001", "category": "sql_injection", "severity": "critical"}}}, {"id": "waf-custom-002", "name": "XSS Protection", "description": "Block cross-site scripting attack patterns", "enabled": true, "expression": "(http.request.uri.query contains \"<script\") || (http.request.body contains \"<script\") || (http.request.uri.query contains \"javascript:\") || (http.request.body contains \"onerror=\") || (http.request.body contains \"onload=\")", "action": "block", "logging": {"enabled": true, "metadata": {"rule_id": "XSS-001", "category": "xss", "severity": "critical"}}}, {"id": "waf-custom-003", "name": "Path Traversal Protection", "description": "Block path traversal attempts", "enabled": true, "expression": "(http.request.uri.path contains \"../\") || (http.request.uri.path contains \"%2e%2e\") || (http.request.uri.path contains \"%252e\") || (http.request.uri.query contains \"..\\/\") || (http.request.body contains \"..//\")", "action": "block", "logging": {"enabled": true, "metadata": {"rule_id": "PT-001", "category": "path_traversal", "severity": "high"}}}, {"id": "waf-custom-004", "name": "Command Injection Protection", "description": "Block command injection attempts", "enabled": true, "expression": "(http.request.uri.query contains \"; rm \") || (http.request.uri.query contains \"| cat \") || (http.request.uri.query contains \"`which`\") || (http.request.body contains \"; wget \") || (http.request.body contains \"| curl \") || (http.request.body.contains \"$(\"))", "action": "block", "logging": {"enabled": true, "metadata": {"rule_id": "CI-001", "category": "command_injection", "severity": "critical"}}}, {"id": "waf-custom-005", "name": "SSRF Protection", "description": "Block server-side request forgery patterns", "enabled": true, "expression": "(http.request.uri.query contains \"metadata.google.internal\") || (http.request.uri.query contains \"169.254.169.254\") || (http.request.uri.query contains \"ec2.\") || (http.request.uri.query contains \"@localhost\") || (http.request.uri.query contains \"127.0.0.1\")", "action": "block", "logging": {"enabled": true, "metadata": {"rule_id": "SSRF-001", "category": "ssrf", "severity": "critical"}}}]}, "ip_access_rules": {"allowlist": [{"value": "10.0.0.0/8", "note": "Internal network (RFC1918)"}, {"value": "172.16.0.0/12", "note": "Private network (RFC1918)"}, {"value": "192.168.0.0/16", "note": "Local network (RFC1918)"}, {"value": "41.0.0.0/8", "note": "Algeria ISP ranges"}, {"value": "196.0.0.0/8", "note": "Algeria additional ranges"}, {"value": "102.50.0.0/16", "note": "Djezzy internal cloud"}], "blocklist": [{"value": "known_attacker_ips", "note": "Threat intelligence blocklist", "source": "auto_update", "update_interval": 3600}, {"value": "tor_exit_nodes", "note": "Tor exit nodes blocked", "source": "tor_project_feed"}, {"value": "known_proxy_abuse", "note": "Proxy services with abuse history"}]}, "incident_response": {"auto_mitigation": {"enabled": true, "trigger_threshold_dos_score": 80, "actions": ["enable_under_attack_mode", "increase_challenge_difficulty", "notify_security_team", "activate_scrubbing_center"]}, "notifications": {"enabled": true, "channels": ["email", "webhook", "pagerduty", "slack"], "recipients": {"email": ["soc-security@djezzy.dz", "noc@djezzy.dz"], "pagerduty": "${PAGERDUTY_INTEGRATION_KEY}", "slack": "${SLACK_WEBHOOK_URL}", "webhook_url": "${DDOS_WEBHOOK_URL}"}, "escalation": {"level_1": {"trigger": "attack_duration > 15min OR dos_score > 70", "actions": ["page_on_call_engineer", "enable_enhanced_logging"]}, "level_2": {"trigger": "attack_duration > 30min OR bandwidth > 10Gbps OR pps > 5M", "actions": ["activate_scrubbing_center", "executive_notification", "consider_origin_failover"]}, "level_3": {"trigger": "attack_duration > 60min OR critical_service_impact", "actions": ["declare_major_incident", "executive_war_room", "law_enforcement_notification_if_needed"]}}}}}