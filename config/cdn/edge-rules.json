{"version": "2.0.0", "name": "Djezzy SOC Platform CDN Edge Rules", "description": "Cloudflare edge caching rules for SOC platform performance optimization", "target_metrics": {"cache_hit_rate_target": 0.95, "p95_response_time_ms": 50, "origin_requests_reduction": 90}, "rules": [{"id": 1, "name": "Static Assets - Aggressive Cache", "description": "Long TTL for versioned static assets with immutable caching", "enabled": true, "expression": "(http.request.uri.path matches \"^/_next/static/\") || (http.request.uri.path matches \"^/static/\") || (http.request.uri.path extension in {\"js\" \"css\" \"woff2\" \"woff\" \"ttf\"})", "priority": 1, "actions": {"cache": {"enabled": true, "cacheTtl": 31536000, "cacheTtlStatusCodes": [{"statusCodeRange": {"from": 200, "to": 299}, "value": 31536000}], "cacheKey": {"cacheDeceptionArmor": false, "ignoreQueryStrings": true, "customKey": ["http.host", "http.request.uri.path"]}, "browserTtl": 31536000, "edgeTtl": 31536000}}, "response": {"headers": {"set": [{"name": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"name": "X-Cache-Status", "value": "STATIC-IMMUTABLE"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 2, "name": "Images - Optimized Cache with Polish", "description": "Cache optimized images with automatic format conversion and quality adjustment", "enabled": true, "expression": "(http.request.uri.path extension in {\"png\" \"jpg\" \"jpeg\" \"gif\" \"svg\" \"webp\" \"avif\" \"ico\"})", "priority": 2, "actions": {"cache": {"enabled": true, "cacheTtl": 2592000, "cacheTtlStatusCodes": [{"statusCodeRange": {"from": 200, "to": 299}, "value": 2592000}], "cacheKey": {"ignoreQueryStrings": true, "customKey": ["http.host", "http.request.uri.path"]}}, "image": {"enabled": true, "formats": ["avif", "webp"], "quality": 85, "widths": [640, 750, 828, 1080, 1200, 1440, 1920, 2048], "fit": "scale-down"}, "polish": {"enabled": true, "options": {"jpeg_quality": 85, "webp_quality": 85, "lossy": true}}}, "response": {"headers": {"set": [{"name": "CDN-Cache-Control", "value": "public, max-age=2592000"}, {"name": "X-Image-Optimized", "value": "true"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 3, "name": "Public API - Short Cache with SWR", "description": "Short TTL cache for public API endpoints with stale-while-revalidate", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api/public\") || (http.request.uri.path starts_with \"/api/metrics\") || (http.request.uri.path starts_with \"/api/health\")", "priority": 3, "actions": {"cache": {"enabled": true, "cacheTtl": 60, "cacheTtlStatusCodes": [{"statusCode": 200, "value": 60}, {"statusCode": 304, "value": 60}], "staleWhileRevalidate": {"enabled": true, "ttl": 59}, "staleIfError": {"enabled": true, "ttl": 300}, "cacheKey": {"includeQueryString": true, "customKey": ["http.host", "http.request.uri.path", "http.request.uri.query"]}}, "origin": {"overrideURL": {"enabled": true, "url": "https://backend.djezzy-soc.internal"}}}, "response": {"headers": {"set": [{"name": "CDN-Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=59, stale-if-error=300"}, {"name": "X-Cache-Type", "value": "edge-api-public"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 4, "name": "Dashboard Pages - ISR Cache", "description": "Incremental Static Regeneration for dashboard pages with session bypass", "enabled": true, "expression": "(http.request.uri.path eq \"/\") || (http.request.uri.path starts_with \"/dashboard\") || (http.request.uri.path starts_with \"/dashboards/\")", "priority": 4, "actions": {"cache": {"enabled": true, "cacheTtl": 10, "staleWhileRevalidate": {"enabled": true, "ttl": 290}, "bypassCacheOnCookie": ["session_id", "auth_token", "_soc_session"], "bypassCacheOnHeader": ["Authorization"], "cacheKey": {"customKey": ["http.host", "http.request.uri.path"]}}, "response": {"headers": {"set": [{"name": "CDN-Cache-Control", "value": "s-maxage=10, stale-while-revalidate=290"}, {"name": "X-ISR", "value": "true"}, {"name": "Vercel-CDN-Cache-Control", "value": "s-maxage=10, stale-while-revalidate=290"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 5, "name": "Authenticated API - No Cache Pass-through", "description": "Pass through authenticated requests without caching to origin", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api/auth\") || (http.request.uri.path starts_with \"/api/users\") || (http.request.uri.path starts_with \"/api/admin\") || (http.request.uri.path contains \"/api/v1/events\")", "priority": 5, "actions": {"cache": {"enabled": false, "bypassCache": true}, "origin": {"overrideURL": {"enabled": true, "url": "https://backend.djezzy-soc.internal"}}}, "response": {"headers": {"set": [{"name": "X-Cache-Bypass", "value": "authenticated-request"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 6, "name": "Alerts & Incidents - Near Real-time Cache", "description": "Very short cache for time-sensitive security data", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api/alerts\") || (http.request.uri.path starts_with \"/api/incidents\")", "priority": 6, "actions": {"cache": {"enabled": true, "cacheTtl": 5, "staleWhileRevalidate": {"enabled": true, "ttl": 55}, "cacheKey": {"includeQueryString": true, "customKey": ["http.host", "http.request.uri.path", "http.request.uri.query"]}}}, "response": {"headers": {"set": [{"name": "CDN-Cache-Control", "value": "public, s-maxage=5, stale-while-revalidate=55"}, {"name": "X-Cache-Type", "value": "near-realtime"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 7, "name": "HTML Pages - Standard Cache", "description": "Standard caching for HTML pages with SWR fallback", "enabled": true, "expression": "(http.response.content_type contains \"text/html\") && (!http.request.uri.path starts_with \"/api\") && (!http.request.uri.path starts_with \"/auth\")", "priority": 7, "actions": {"cache": {"enabled": true, "cacheTtl": 300, "staleWhileRevalidate": {"enabled": true, "ttl": 86400}, "respectStrongETags": true}}, "response": {"headers": {"set": [{"name": "X-Page-Cache", "value": "HIT"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 8, "name": "Fonts - Long Cache Immutable with CORS", "description": "Font files with long cache and CORS headers for cross-origin loading", "enabled": true, "expression": "(http.request.uri.path extension in {\"woff2\" \"woff\" \"ttf\" \"otf\" \"eot\"}) && (http.request.uri.path starts_with \"/fonts/\")", "priority": 8, "actions": {"cache": {"enabled": true, "cacheTtl": 31536000, "cacheTtlStatusCodes": [{"statusCodeRange": {"from": 200, "to": 299}, "value": 31536000}]}, "response": {"headers": {"set": [{"name": "Access-Control-Allow-Origin", "value": "*"}, {"name": "Timing-Allow-Origin", "value": "*"}, {"name": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"name": "Cross-Origin-Resource-Policy", "value": "cross-origin"}]}}, "logging": {"enabled": true}, "last": true}, {"id": 9, "name": "Security Headers - All Responses", "description": "Add comprehensive security headers to all responses", "enabled": true, "expression": "true", "priority": 100, "actions": {"response": {"headers": {"set": [{"name": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload; sameSite=lax"}, {"name": "X-Content-Type-Options", "value": "nosniff"}, {"name": "X-Frame-Options", "value": "SAMEORIGIN"}, {"name": "X-XSS-Protection", "value": "1; mode=block"}, {"name": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"name": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"}, {"name": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' wss: https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"}, {"name": "X-Permitted-Cross-Domain-Policies", "value": "none"}, {"name": "Cache-Control", "value": "no-transform"}]}}}, "last": false}, {"id": 10, "name": "CORS Headers - API Requests", "description": "CORS configuration for API requests with proper preflight handling", "enabled": true, "expression": "(http.request.uri.path starts_with \"/api\")", "priority": 101, "actions": {"response": {"headers": {"set": [{"name": "Access-Control-Allow-Origin", "value": "https://soc.djezzy.dz"}, {"name": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS"}, {"name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Request-ID, X-API-Key, X-Correlation-ID, X-SOC-Token, X-Batch-Size, X-Ingestion-Token"}, {"name": "Access-Control-Max-Age", "value": "86400"}, {"name": "Access-Control-Expose-Headers", "value": "X-Request-ID, X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, X-Cache-Status, X-Response-Time"}, {"name": "Access-Control-Allow-Credentials", "value": "true"}]}, "status_code": {"value": 204, "overrides": [{"matches": [{"expression": "(http.request.method eq \"OPTIONS\")"}], "value": 204}]}}, "last": true}, {"id": 11, "name": "Compression - Brotli/Gzip Optimization", "description": "Enable compression for text-based content types", "enabled": true, "expression": "(http.response.content_type contains \"text/\") || (http.response.content_type contains \"application/json\") || (http.response.content_type contains \"application/javascript\") || (http.response.content_type contains \"application/xml\") || (http.response.content_type contains \"text/event-stream\")", "priority": 102, "actions": {"compress": {"algorithms": ["brotli", "gzip"], "minimumSizeBytes": 500, "brotliQuality": 4}}, "last": true}, {"id": 12, "name": "Early Hints Optimization", "description": "Send Early Hints for faster page loads on supporting browsers", "enabled": true, "expression": "(http.request.uri.path eq \"/\") || (http.request.uri.path starts_with \"/dashboard\")", "priority": 103, "actions": {"earlyHints": {"links": ["/_next/static/css/main.css;rel=preload;as=style;crossorigin", "/_next/static/chunks/main.js;rel=preload;as=script;crossorigin", "/logo.svg;rel=preload;as=image"]}}, "last": true}, {"id": 13, "name": "Bot Mitigation - Block Malicious Bots", "description": "Block known malicious bots and security scanners", "enabled": true, "expression": "(cf.client.bot) || (http.user_agent contains \"sqlmap\") || (http.user_agent contains \"nikto\") || (http.user_agent contains \"nmap\") || (http.user_agent contains \"masscan\") || (http.user_agent contains \"gobuster\") || (http.user_agent contains \"dirbuster\")", "priority": 200, "actions": {"block": {"mode": "managedChallenge", "statusCode": 403, "response": {"content_type": "text/plain", "body": "Access Denied - Security scanning not permitted"}}}, "logging": {"enabled": true}, "last": true}, {"id": 14, "name": "Geo-Routing - Algeria Priority", "description": "Route Algerian users to Algiers POP for lowest latency", "enabled": true, "expression": "(cf.ip.country eq \"DZ\")", "priority": 150, "actions": {"response": {"headers": {"set": [{"name": "X-POP-Location", "value": "Algiers"}, {"name": "X-Latency-Tier", "value": "tier-1"}]}, "origin": {"overrideURL": {"enabled": true, "url": "https://backend-algiers.djezzy-soc.internal"}}}, "last": true}], "default_settings": {"cache_level": "advanced", "ssl_mode": "full", "http2": true, "http3": true, "pseudo_ipv4": "off", "websockets": true, "minify": {"javascript": true, "css": true, "html": true}}}